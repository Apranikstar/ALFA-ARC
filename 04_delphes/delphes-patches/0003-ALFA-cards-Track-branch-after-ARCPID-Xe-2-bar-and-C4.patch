+    set UseMomentumVector true
+
+    set EfficiencyFormula {
+        (abs(eta) > 2.6)                                  * (0.000) +
+        (pt < 0.1) * (abs(eta) <= 2.6)       * (0.000) +
+        (pt >= 0.1) * (abs(eta) <= 2.6)      * (1.000)
+    }
+}
