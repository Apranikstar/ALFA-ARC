+COMMON = """
+  ## aerogel radiator: k4geo Aerogel_PFRICH (design value 1.03 not used by the full sim). n and dn/dE at the detected <E> = 3.0 eV,
+  ## sigma_E = rms of the detected aerogel spectrum (T12, 90 deg). Chromatic term ~2.7 mrad dominates.
+  set AerogelRefractiveIndex 1.0193
+  # set AerogelRefractiveIndex 1.03   ;# design value
+  set AerogelDnDe 7.9E-4
+  set AerogelSigmaE 0.655
+  ## non-chromatic per-photon part: T06 full ALFA, 90 deg (sigma1 3.7 mrad = pixel 1.2 (+) chromatic 2.7 (+) emission 2.4)
+  set AerogelSigmaSingle 2.6E-3
+  ## ring photons at beta = 1 (T06 per-photon reco, T12): 7.65 at 90 deg with L = 0.98 cm -> N_sat 7.8 for L_ref 1 cm
+  set AerogelNsat 7.8
+  set AerogelLref 0.01
+  set AerogelThickness 0.0098
+
+  ## per-photon spread from the track curving across the radiator: sigma_bend = BendingCoefficient * 0.3 * B * L * sin(theta) / p.
+  ## Fit to the T06 full-ALFA gas sigma1(p), pi/K/p 5-50 GeV: k = 0.19 at 90 deg, 0.19 at 20-30 deg, 0.12-0.17 at 45-75 deg
+  ## (1/sqrt(12) = 0.29 overestimates). Negligible for the 1 cm aerogel.
+  set BendingCoefficient 0.19
+
+  ## a ring needs at least MinPe photo-electrons (as in the T06 reconstruction)
+  set MinPe 3.0
+  set SigmaTrack 0.0
+  ## Poisson-fluctuate the yield per track, as in full sim (the July ARCPID study used false)
+  set PoissonFluctuation true
+  set UseTrueMomentumForPID false
+
+  ## ring-finding efficiency vs |eta| from T06 (per-photon reconstruction, beta = 1, theta = 90/75/60/45/30/20 deg; ~+-0.03 stat).
+  ## Aerogel: barrel-endcap crack theta 41-43 deg (|eta| 0.932-0.984), path -> 0 (T12 part A). The gas path is continuous.
+  set GasEfficiencyFormula {
+    (abs(eta) <= 0.40) * 0.97 +
+    (abs(eta) > 0.40 && abs(eta) <= 0.72) * 1.00 +
+    (abs(eta) > 0.72 && abs(eta) <= 1.10) * 0.81 +
+    (abs(eta) > 1.10 && abs(eta) <= 1.50) * 0.79 +
+    (abs(eta) > 1.50) * 1.00
