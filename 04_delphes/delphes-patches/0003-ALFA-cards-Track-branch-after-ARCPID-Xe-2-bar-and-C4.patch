+    (abs(eta) > 0.72 && abs(eta) <= 0.932) * 0.95 +
+    (abs(eta) > 0.932 && abs(eta) <= 0.984) * 0.00 +
+    (abs(eta) > 0.984 && abs(eta) <= 1.50) * 0.86 +
