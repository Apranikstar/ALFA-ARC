+  ##   s1_barrel: even polynomial in x, c = 3.666, 3.975, -2.817 (chi2/ndf 2.21, x in [0.065, 0.962])
+  ##   s1_endcap: even polynomial in x, c = 2.493, 5.142, -4.077 (chi2/ndf 1.02, x in [0.237, 0.777])
+  ##   sc_barrel: even polynomial in x, c = 0.1973, 2.346, -1.56 (chi2/ndf 0.73, x in [0.065, 0.962])
+  ##   sc_endcap: even polynomial in x, c = 0.04233, 0.9441 (chi2/ndf 1.11, x in [0.237, 0.777])
+  ##   Y_barrel: even polynomial in x, c = 0.9897, -1.56, 3.127, -1.893 (chi2/ndf 2.01, x in [0.065, 0.962])
+  ##   Y_endcap: even polynomial in x, c = 1.071, -1.362, 3.21, -2.858 (chi2/ndf 0.65, x in [0.237, 0.777])
+  ##   E_barrel: even polynomial in x, c = 0.9967, -0.3993, 0.2571 (chi2/ndf 5.00, x in [0.065, 0.962])
+  ##   E_endcap: even polynomial in x, c = 1.029, -0.4456 (chi2/ndf 9.17, x in [0.237, 0.777])
