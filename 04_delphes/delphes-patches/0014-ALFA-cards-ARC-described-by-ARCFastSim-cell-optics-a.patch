+#########################################
+# ARC: Array of RICH Cells, per-track PID
+#########################################
+
+module ARCPID ARCPID {
+  set InputArray TrackSmearing/tracks
+  set OutputArray tracks
+
+  set Bz $::B
+
+  ## ARC envelope [m]
+  set BarrelRmin $::ARCBRMIN
+  set BarrelRmax $::ARCBRMAX
+  set BarrelZmax $::ARCBZMAX
+  set EndcapZmin $::ARCEZMIN
+  set EndcapZmax $::ARCEZMAX
+  set EndcapRmin $::ARCERMIN
+  set EndcapRmax $::ARCERMAX
+
+  ## gas radiator: xenon at 2 bar, 293.15 K (k4geo Xenon_ARC, ALFA_o1_v01). n and dn/dE at the PDE-weighted mean detected photon
+  ## energy <E> = 3.02 eV (T11prep), sigma_E = rms of the detected gas spectrum (T12). Thresholds pi/K/p = 2.71 / 9.59 / 18.2 GeV.
+  set GasRefractiveIndex 1.00132
+  set GasDnDe 6.17E-5
+  set GasSigmaE 0.68
+  ## per-photon resolution without the chromatic part [rad] (pixel 1.25 (+) emission), cell-averaged full sim (T06b sample, reconstruction v2), smooth in the
+  ## cell off-axis variable; even-polynomial fits (s1^2 and s_c^2 in mrad^2, chromatic included in s1 and removed here; Y; E).
+  ## Residuals of the smooth forms around the cell-averaged points: s1 <= 2%, s_c 3-9%, Y and E <= 3.6% rms (systematic):
+  ##   s1_barrel: even polynomial in x, c = 4.031, 4.543, -3.264 (chi2/ndf 0.48, x in [0.064, 0.963])
+  ##   s1_endcap: even polynomial in x, c = 2.668, 8.007, -7.71 (chi2/ndf 2.84, x in [0.237, 0.777])
+  ##   sc_barrel: even polynomial in x, c = 0.2222, 2.216, -1.469 (chi2/ndf 0.75, x in [0.064, 0.963])
+  ##   sc_endcap: even polynomial in x, c = 0.0837, 0.9637 (chi2/ndf 3.15, x in [0.237, 0.777])
+  ##   Y_barrel: even polynomial in x, c = 0.9806, -1.275, 2.276, -1.235 (chi2/ndf 7.30, x in [0.064, 0.963])
+  ##   Y_endcap: even polynomial in x, c = 1.012, -0.5292, 0.418 (chi2/ndf 0.72, x in [0.237, 0.777])
+  ##   E_barrel: even polynomial in x, c = 0.9931, -0.3043, 0.1678 (chi2/ndf 2.79, x in [0.064, 0.963])
+  ##   E_endcap: even polynomial in x, c = 1.019, -0.3722 (chi2/ndf 2.44, x in [0.237, 0.777])
+  set GasSigmaSingle 0.001837
+  set GasSigmaSingleFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (4.03118) + (4.54278) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (-3.26382) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4) - (0.6561)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.002404) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (2.66841) + (8.00714) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) + (-7.71009) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 4) - (0.6561))))
+  }
+  ## per-track correlated term [rad] (does not average down with N_pe): cell-position-dependent bias of the optics
+  set GasSigmaCorrFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (0.222165) + (2.21616) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (-1.46905) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4) - (0)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.001214) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (0.0836954) + (0.963699) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) - (0))))
+  }
+  ## photons at beta = 1 for L = L_ref at normal incidence (cell-averaged); ideal mirror, x 0.90 for a 90% mirror (T07)
+  set GasNsat 10.33
+  set GasLref 0.15
+  ## gas crossed at normal incidence through the k4geo cells (T12 part A): 16.9 cm barrel, 16.7 cm endcap
+  set GasThickness 0.169
+  ## light collection relative to the path scaling N_sat L / L_ref (photons leave the cell at oblique incidence)
+  set GasYieldScaleFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, (0.980605) + (-1.27471) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (2.27625) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4) + (-1.23457) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 6))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.4818) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, (1.01152) + (-0.529153) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) + (0.417971) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 4)))
+  }
+
+  ## aerogel radiator: k4geo Aerogel_PFRICH (design value 1.03 not used by the full sim). n and dn/dE at the detected <E> = 3.0 eV,
+  ## sigma_E = rms of the detected aerogel spectrum (T12, 90 deg). The chromatic term (2.7 mrad at beta = 1) dominates.
+  set AerogelRefractiveIndex 1.0193
+  # set AerogelRefractiveIndex 1.03   ;# design value
+  set AerogelDnDe 7.9E-4
+  set AerogelSigmaE 0.655
+  ## per-photon resolution without the chromatic part [rad] (pixel 1.23 (+) emission); fits (mrad, chromatic included):
+  ##   s1_barrel: even polynomial in x, c = 7.927, 10.26, -5.155 (chi2/ndf 3.84, x in [0.064, 0.963])
+  ##   s1_endcap: even polynomial in x, c = 7.961, 4.457 (chi2/ndf 1.68, x in [0.237, 0.777])
+  ##   sc_barrel: even polynomial in x, c = 1.09, 4.603, 7.072 (chi2/ndf 5.24, x in [0.064, 0.963])
+  ##   sc_endcap: even polynomial in x, c = 0.5481, 5.177 (chi2/ndf 6.19, x in [0.237, 0.777])
+  ##   Y_barrel: even polynomial in x, c = 0.9963, 0.5098, -0.4621 (chi2/ndf 1.31, x in [0.064, 0.963])
+  ##   Y_endcap: even polynomial in x, c = 1.065, 0.343, -0.7597 (chi2/ndf 1.45, x in [0.237, 0.777])
+  ##   E_barrel: even polynomial in x, c = 0.9356, -0.3351, 0.3901 (chi2/ndf 12.10, x in [0.064, 0.963])
+  ##   E_endcap: even polynomial in x, c = 0.9634, -0.1257 (chi2/ndf 1.44, x in [0.237, 0.777])
+  set AerogelSigmaSingle 0.0008627
+  set AerogelSigmaSingleFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (7.92673) + (10.264) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (-5.15479) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4) - (7.1824)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.001959) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (7.96104) + (4.45659) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) - (7.1824))))
+  }
+  set AerogelSigmaCorrFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (1.09024) + (4.60252) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (7.07202) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4) - (0)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.003348) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (0.548088) + (5.17747) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) - (0))))
+  }
+  set AerogelNsat 6.893
+  set AerogelLref 0.01
+  set AerogelThickness 0.0098
+  set AerogelYieldScaleFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, (0.996297) + (0.509791) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (-0.462148) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.7701) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, (1.06499) + (0.342977) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) + (-0.75975) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 4)))
+  }
+
+  ## per-photon spread from the track curving across the radiator: sigma_bend = BendingCoefficient * 0.3 * B * L * sin(theta) / p,
+  ## weighted mean of the per-bin gas fits (T06b sample, reconstruction v2); the reconstruction already corrects for the helix, so k < 1/sqrt(12)
+  set BendingCoefficient 0.155
+
+  ## a ring needs at least MinPe detected photons (as in the T06 reconstruction); the yield fluctuates per track (Poisson)
+  set MinPe 3.0
+  set SigmaTrack 0.0
+  set PoissonFluctuation true
+  set UseTrueMomentumForPID false
+
+  ## ring-finding efficiency (ring lost: cell edge, mirror gap; < 3 photons is handled by MinPe), cell-averaged
+  set GasEfficiencyFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, TMath::Min(1.0, (0.99314) + (-0.304309) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (0.167752) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.123) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, TMath::Min(1.0, (1.01939) + (-0.372212) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2))))
+  }
+  set AerogelEfficiencyFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, TMath::Min(1.0, (0.935647) + (-0.335124) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (0.390113) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.1878) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, TMath::Min(1.0, (0.963367) + (-0.125678) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2))))
+  }
+}
