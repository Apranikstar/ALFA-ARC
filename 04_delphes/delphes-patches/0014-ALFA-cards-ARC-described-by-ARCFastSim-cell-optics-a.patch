+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (3.6655) + (3.97508) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (-2.81743) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4) - (0.0841)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.002316) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (2.49291) + (5.14229) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2) + (-4.07741) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 4) - (0.0841))))
+  }
