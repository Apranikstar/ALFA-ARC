+  ## light collection relative to the path scaling N_sat L / L_ref (photons leave the cell at oblique incidence)
+  set GasYieldScaleFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, (0.989693) + (-1.55991) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (3.12691) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4) + (-1.89278) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 6))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.4746) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, (1.07075) + (-1.36157) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2) + (3.20997) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 4) + (-2.85814) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 6)))
+  }
+
+  ## aerogel radiator: k4geo Aerogel_PFRICH (design value 1.03 not used by the full sim). n and dn/dE at the detected <E> = 3.0 eV,
+  ## sigma_E = rms of the detected aerogel spectrum (T12, 90 deg). The chromatic term (2.7 mrad at beta = 1) dominates.
+  set AerogelRefractiveIndex 1.0193
+  # set AerogelRefractiveIndex 1.03   ;# design value
+  set AerogelDnDe 7.9E-4
+  set AerogelSigmaE 0.655
+  ## per-photon resolution without the chromatic part [rad] (pixel 1.23 (+) emission); fits (mrad, chromatic included):
+  ##   s1_barrel: even polynomial in x, c = 8.218, 5.945 (chi2/ndf 4.06, x in [0.065, 0.962])
+  ##   s1_endcap: even polynomial in x, c = 7.755, 5.085 (chi2/ndf 3.97, x in [0.237, 0.777])
+  ##   sc_barrel: even polynomial in x, c = 0.8335, 9.589 (chi2/ndf 8.43, x in [0.065, 0.962])
+  ##   sc_endcap: even polynomial in x, c = 0.5542, 5.496 (chi2/ndf 4.86, x in [0.237, 0.777])
+  ##   Y_barrel: even polynomial in x, c = 0.9745, 0.4284, -0.4517 (chi2/ndf 2.62, x in [0.065, 0.962])
+  ##   Y_endcap: even polynomial in x, c = 0.9466, 0.6936, -1.232 (chi2/ndf 2.87, x in [0.237, 0.777])
+  ##   E_barrel: even polynomial in x, c = 0.947, -0.3253, 0.3695 (chi2/ndf 5.00, x in [0.065, 0.962])
+  ##   E_endcap: even polynomial in x, c = 0.9645, -0.1553 (chi2/ndf 1.96, x in [0.237, 0.777])
+  set AerogelSigmaSingle 0.001018
+  set AerogelSigmaSingleFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (8.21796) + (5.94481) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) - (7.1824)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.001885) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (7.75537) + (5.08476) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2) - (7.1824))))
+  }
+  set AerogelSigmaCorrFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (0.833498) + (9.58905) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) - (0)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.003142) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (0.554187) + (5.4964) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2) - (0))))
+  }
+  set AerogelNsat 7.138
+  set AerogelLref 0.01
+  set AerogelThickness 0.0098
+  set AerogelYieldScaleFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, (0.974529) + (0.428407) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (-0.451704) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.6762) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, (0.94661) + (0.693558) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2) + (-1.23188) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 4)))
+  }
+
+  ## per-photon spread from the track curving across the radiator: sigma_bend = BendingCoefficient * 0.3 * B * L * sin(theta) / p,
+  ## weighted mean of the per-bin gas fits (T06b sample, reconstruction v2); the reconstruction already corrects for the helix, so k < 1/sqrt(12)
+  set BendingCoefficient 0.147
+
+  ## a ring needs at least MinPe detected photons (as in the T06 reconstruction); the yield fluctuates per track (Poisson)
+  set MinPe 3.0
+  set SigmaTrack 0.0
+  set PoissonFluctuation true
+  set UseTrueMomentumForPID false
+
+  ## ring-finding efficiency (ring lost: cell edge, mirror gap; < 3 photons is handled by MinPe), cell-averaged
+  set GasEfficiencyFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, TMath::Min(1.0, (0.996715) + (-0.399332) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (0.257123) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.08889) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, TMath::Min(1.0, (1.02943) + (-0.445575) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2))))
+  }
+  set AerogelEfficiencyFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, TMath::Min(1.0, (0.946969) + (-0.325256) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (0.369536) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.149) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, TMath::Min(1.0, (0.964534) + (-0.1553) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2))))
+  }
+}
