+with the k4geo full-simulation calibration (T05, T06, T11prep, T12; work/T11/calib_v2.json).
+
+Calibration v2: sigma_single is the ARCPID definition, per-track sigma x sqrt(N_pe), taken from the T06 per-track resolution
+(robust mean of the photons, two passes of 3-sigma rejection), not from the raw per-photon rms (which includes tails the
+per-track estimator removes). Resolution, photon yield and ring-finding efficiency depend on theta; they are given as
+formulas in |eta| (the Delphes variable) with bins centred on the T06 grid angles theta = 90, 75, 60, 45, 30, 20 deg."""
+
+# |eta| bin edges and the theta [deg] they represent; the 5th bin is the barrel-endcap crack (theta 41.6-43.6 deg)
+EDGES = [0.0, 0.13, 0.40, 0.72, 0.932, 0.984, 1.52, None]
+THETA = ["90 deg", "75 deg", "60 deg", "45 deg", "crack", "30 deg", "20 deg"]
+
+
+def formula(vals, fmt="{:.3g}"):
+    """TFormula string for a step function in |eta| over EDGES."""
+    terms = []
+    for k, v in enumerate(vals):
+        lo, hi = EDGES[k], EDGES[k + 1]
+        cond = f"(abs(eta) > {lo})" if hi is None else (f"(abs(eta) <= {hi})" if lo == 0 else f"(abs(eta) > {lo} && abs(eta) <= {hi})")
+        terms.append(f"    {cond} * {fmt.format(v)}")
+    return "{\n" + " +\n".join(terms) + "\n  }"
+
+
+def table(vals, unit=""):
+    return "  ##   " + ", ".join(f"{t}: {v:g}{unit}" for t, v in zip(THETA, vals))
+
+
+# T06 (Xe 2 bar, full ALFA, 3 T): full-sim ring photons at beta = 1 over the card's N_sat (L/L_ref) with L = t/sin or t/|cos|
+GAS_YIELD = [1.00, 1.10, 0.86, 0.63, 0.80, 0.80, 0.99]
+AERO_YIELD = [1.00, 0.91, 0.78, 0.93, 0.74, 0.74, 0.81]
+# non-chromatic part of sigma_track x sqrt(N_pe) [mrad]; gas: constant of the fit c0 + (k 0.3 B t / p)^2, aerogel: rms over p (bending negligible)
+GAS_S1_XE = [1.59, 1.58, 1.70, 3.82, 2.54, 2.54, 1.58]
+AERO_S1 = [0.3, 1.89, 3.06, 8.32, 2.19, 2.19, 1.12]   # 0.3 = floor at 90 deg where the chromatic term alone (2.68) saturates the measurement (2.65)
+# standalone ARC cell (T11prep, no field): non-chromatic sigma_eff C4F10 1.78, Xe 1.53 mrad -> C4F10 = Xe x 1.16 at every theta (assumption)
+GAS_S1_C4F10 = [round(1.16 * v, 2) for v in GAS_S1_XE]
+
