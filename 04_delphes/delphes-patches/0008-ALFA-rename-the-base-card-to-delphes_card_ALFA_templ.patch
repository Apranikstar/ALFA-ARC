+# ALFA Delphes card, ARC gas variant: C4F10 (generated by examples/ALFA/make_cards.py from delphes_card_ALFA_template.tcl, calibration v3)
 set RandomSeed 123
 
 #####################################################################
diff --git a/cards/delphes_card_ALFA_Xe2bar.tcl b/cards/delphes_card_ALFA_Xe2bar.tcl
