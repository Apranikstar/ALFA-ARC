 ```bash
-./DelphesPythia8 cards/delphes_card_ALFA.tcl examples/ALFA/gun_kp.cmnd  kp.root
-./DelphesPythia8 cards/delphes_card_ALFA.tcl examples/ALFA/gun_pip.cmnd pip.root
-./DelphesPythia8 cards/delphes_card_ALFA.tcl examples/ALFA/gun_p.cmnd   p.root
+./DelphesPythia8 cards/delphes_card_ALFA_Xe2bar.tcl examples/ALFA/gun_kp.cmnd  kp.root
+./DelphesPythia8 cards/delphes_card_ALFA_Xe2bar.tcl examples/ALFA/gun_pip.cmnd pip.root
+./DelphesPythia8 cards/delphes_card_ALFA_Xe2bar.tcl examples/ALFA/gun_p.cmnd   p.root
 python3 examples/ALFA/arc_separation.py --pi pip.root --k kp.root --p p.root --out plots
 ```
 
