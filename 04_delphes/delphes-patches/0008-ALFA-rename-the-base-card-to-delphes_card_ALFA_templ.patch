+++ b/cards/delphes_card_ALFA_Xe2bar.tcl
@@ -1,4 +1,4 @@
-# ALFA Delphes card, ARC gas variant: Xe2bar (generated by examples/ALFA/make_cards.py from delphes_card_ALFA.tcl, calibration v3)
+# ALFA Delphes card, ARC gas variant: Xe2bar (generated by examples/ALFA/make_cards.py from delphes_card_ALFA_template.tcl, calibration v3)
 set RandomSeed 123
 
 #####################################################################
diff --git a/cards/delphes_card_ALFA.tcl b/cards/delphes_card_ALFA_template.tcl
similarity index 97%
rename from cards/delphes_card_ALFA.tcl
rename to cards/delphes_card_ALFA_template.tcl
index a6f673c..b526da5 100644
--- a/cards/delphes_card_ALFA.tcl
+++ b/cards/delphes_card_ALFA_template.tcl
@@ -1,3 +1,10 @@
+#####################################################################
+# TEMPLATE -- NOT FOR PRODUCTION.
+# Source of the ALFA cards: everything outside the ARCPID block is shared; the ARCPID block here holds the
+# first-pass placeholders of the original bundle (N_sat 14, 15 cm gas, constant resolution, no theta dependence).
+# Use cards/delphes_card_ALFA_Xe2bar.tcl (xenon 2 bar, main) or cards/delphes_card_ALFA_C4F10.tcl, which
+# examples/ALFA/make_cards.py generates from this file with the ARCPID block calibrated on the k4geo full simulation.
+#####################################################################
 set RandomSeed 123
 
 #####################################################################
diff --git a/examples/ALFA/README.md b/examples/ALFA/README.md
index 8a1415a..ff14d30 100644
--- a/examples/ALFA/README.md
+++ b/examples/ALFA/README.md
@@ -8,7 +8,10 @@ Files added to Delphes:
 | `classes/DelphesClasses.h/.cc` | 16 new members on `Candidate` and `Track` (see below); `ClassDef` versions bumped |
 | `modules/TreeWriter.cc` | fills the new `Track` members |
 | `modules/ModulesLinkDef.h` | registers `ARCPID` |
-| `cards/delphes_card_ALFA.tcl` | the ALFA card (3 T, all-MAPS tracker, ARC, GRAiNITA ECAL) |
+| `cards/delphes_card_ALFA_Xe2bar.tcl` | the ALFA card, ARC with xenon at 2 bar (main; 3 T, all-MAPS tracker, ARC, GRAiNITA ECAL) |
