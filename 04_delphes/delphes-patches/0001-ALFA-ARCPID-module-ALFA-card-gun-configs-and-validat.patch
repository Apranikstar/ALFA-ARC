+
+  set DeltaR 0.5
+  set TauPTMin 1.0
+  set TauEtaMax 3.0
+
+  # default efficiency formula (misidentification rate)
+  add EfficiencyFormula {0} {0.01}
+  # efficiency formula for tau-jets
+  add EfficiencyFormula {15} {0.85}
+}
