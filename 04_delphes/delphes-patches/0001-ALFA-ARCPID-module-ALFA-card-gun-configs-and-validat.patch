+ *  but WITHOUT ANY WARRANTY; without even the implied warranty of
+ *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ *  GNU General Public License for more details.
+ *
+ *  You should have received a copy of the GNU General Public License
+ *  along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/** \class ARCPID
+ *
+ *  Per-track Cherenkov emulation of the ARC (Array of RICH Cells) detector.
+ *  See ARCPID.h for the algorithm. Besides the per-hypothesis chi2 it stores
+ *  normalised hypothesis probabilities and the mass of the best hypothesis.
+ *
+ */
+
+#include "modules/ARCPID.h"
+
+#include "classes/DelphesClasses.h"
+#include "classes/DelphesFormula.h"
+
+#include "TLorentzVector.h"
+#include "TMath.h"
+#include "TObjArray.h"
+#include "TRandom3.h"
+
+#include <cmath>
+#include <iostream>
+#include <memory>
+
+using namespace std;
+
+namespace
+{
+  const Double_t kMassPi = 0.13957039;
+  const Double_t kMassK = 0.493677;
+  const Double_t kMassP = 0.93827209;
+}
+
+//------------------------------------------------------------------------------
+
+ARCPID::ARCPID()
+{
+  fGasEfficiency = make_unique<DelphesFormula>();
+  fAerogelEfficiency = make_unique<DelphesFormula>();
+}
+
+//------------------------------------------------------------------------------
+
+ARCPID::~ARCPID()
+{
+}
+
+//------------------------------------------------------------------------------
+
+void ARCPID::Init()
+{
+  // ARC envelope, in meters. The barrel is a cylinder r in [BarrelRmin, BarrelRmax],
+  // |z| <= BarrelZmax; the endcaps are disks |z| in [EndcapZmin, EndcapZmax],
+  // r in [EndcapRmin, EndcapRmax]. Defaults follow k4geo ALFA_o1_v01.
+  fBarrelRmin = GetDouble("BarrelRmin", 1.90);
+  fBarrelRmax = GetDouble("BarrelRmax", 2.10);
+  fBarrelZmax = GetDouble("BarrelZmax", 2.20);
+  fEndcapZmin = GetDouble("EndcapZmin", 2.00);
+  fEndcapZmax = GetDouble("EndcapZmax", 2.20);
+  fEndcapRmin = GetDouble("EndcapRmin", 0.28);
+  fEndcapRmax = GetDouble("EndcapRmax", 1.90);
+
+  fBz = GetDouble("Bz", 2.0);
+
+  // gas radiator (defaults: xenon at 2 bar, which has the index of C4F10 at 1 bar)
+  fRad[kGas].n = GetDouble("GasRefractiveIndex", 1.0014);
+  fRad[kGas].sigmaSingle = GetDouble("GasSigmaSingle", 1.3E-3);
+  fRad[kGas].dnde = GetDouble("GasDnDe", 0.0);
+  fRad[kGas].sigmaE = GetDouble("GasSigmaE", 0.0);
+  fRad[kGas].nSat = GetDouble("GasNsat", 14.0);
+  fRad[kGas].lRef = GetDouble("GasLref", 0.15);
+  fRad[kGas].thickness = GetDouble("GasThickness", 0.15);
+
+  // aerogel radiator
+  fRad[kAerogel].n = GetDouble("AerogelRefractiveIndex", 1.03);
+  fRad[kAerogel].sigmaSingle = GetDouble("AerogelSigmaSingle", 1.5E-3);
+  fRad[kAerogel].dnde = GetDouble("AerogelDnDe", 0.0);
+  fRad[kAerogel].sigmaE = GetDouble("AerogelSigmaE", 0.0);
+  fRad[kAerogel].nSat = GetDouble("AerogelNsat", 7.0);
+  fRad[kAerogel].lRef = GetDouble("AerogelLref", 0.01);
+  fRad[kAerogel].thickness = GetDouble("AerogelThickness", 0.01);
+
+  for(int i = 0; i < 2; ++i)
+  {
+    fRad[i].sin2max = 1.0 - 1.0 / (fRad[i].n * fRad[i].n);
+  }
+
+  fMinPe = GetDouble("MinPe", 3.0);
+  fSigmaTrack = GetDouble("SigmaTrack", 0.0);
+  fBendingCoefficient = GetDouble("BendingCoefficient", 1.0 / TMath::Sqrt(12.0));
+  fPoissonFluctuation = GetBool("PoissonFluctuation", false);
+  fUseTrueMomentumForPID = GetBool("UseTrueMomentumForPID", false);
+
+  // ring-finding efficiency as a function of (pt, eta) of the track; 1.0 = geometric acceptance only
+  fGasEfficiency->Compile(GetString("GasEfficiencyFormula", "1.0"));
+  fAerogelEfficiency->Compile(GetString("AerogelEfficiencyFormula", "1.0"));
+
+  fInputArray = ImportArray(GetString("InputArray", "TrackSmearing/tracks"));
+  fItInputArray.reset(fInputArray->MakeIterator());
+
+  fOutputArray = ExportArray(GetString("OutputArray", "tracks"));
+}
+
+//------------------------------------------------------------------------------
+
+void ARCPID::Finish()
+{
+}
+
+//------------------------------------------------------------------------------
+
+Double_t ARCPID::CherenkovAngle(const RadiatorParams &r, Double_t beta) const
+{
+  Double_t c = 1.0 / (r.n * beta);
+  if(c >= 1.0) return -1.0;
+  return TMath::ACos(c);
+}
+
+//------------------------------------------------------------------------------
+
+Double_t ARCPID::SigmaSinglePhoton(const RadiatorParams &r, Double_t thetaC, Double_t bend) const
+{
+  Double_t chrom = 0.0;
+  if(r.dnde > 0.0 && r.sigmaE > 0.0 && thetaC > 0.0)
+  {
+    chrom = r.dnde * r.sigmaE / (r.n * TMath::Tan(thetaC));
+  }
+  return TMath::Sqrt(r.sigmaSingle * r.sigmaSingle + chrom * chrom + bend * bend);
+}
+
+//------------------------------------------------------------------------------
+
+Double_t ARCPID::SigmaTrack(const RadiatorParams &r, Double_t thetaC, Double_t npe, Double_t bend) const
+{
+  Double_t s1 = SigmaSinglePhoton(r, thetaC, bend);
+  return TMath::Sqrt(s1 * s1 / npe + fSigmaTrack * fSigmaTrack);
+}
+
+//------------------------------------------------------------------------------
+
+Double_t ARCPID::ExpectedNpe(const RadiatorParams &r, Double_t beta, Double_t L) const
+{
+  Double_t c = 1.0 / (r.n * beta);
+  if(c >= 1.0 || L <= 0.0) return 0.0;
+  Double_t sin2 = 1.0 - c * c;
+  return r.nSat * (L / r.lRef) * sin2 / r.sin2max;
+}
+
+//------------------------------------------------------------------------------
+
+void ARCPID::Process()
+{
+  Candidate *candidate, *mother, *particle;
+
+  fItInputArray->Reset();
+  while((candidate = static_cast<Candidate *>(fItInputArray->Next())))
+  {
+    // the first daughter is the generated particle: true momentum and mass
+    particle = static_cast<Candidate *>(candidate->GetCandidates()->At(0));
+    const TLorentzVector &trueMomentum = particle->Momentum;
+    const TLorentzVector &recoMomentum = candidate->Momentum;
+
+    mother = candidate;
+    candidate = static_cast<Candidate *>(candidate->Clone());
+
+    // defaults: no ring, no PID
+    candidate->CherenkovAngleGas = -1.0;
+    candidate->CherenkovAngleAerogel = -1.0;
+    candidate->CherenkovRecoAngleGas = -1.0;
+    candidate->CherenkovRecoAngleAerogel = -1.0;
+    candidate->SigmaThetaCGas = -1.0;
+    candidate->SigmaThetaCAerogel = -1.0;
+    candidate->NpeGas = 0.0;
+    candidate->NpeAerogel = 0.0;
+    candidate->ARCchi2Pi = -1.0;
+    candidate->ARCchi2K = -1.0;
+    candidate->ARCchi2P = -1.0;
+    candidate->ARCpid = 0;
+    candidate->ARCprobPi = -1.0;
+    candidate->ARCprobK = -1.0;
+    candidate->ARCprobP = -1.0;
+    candidate->ARCmass = -1.0;
+
+    Double_t pTrue = trueMomentum.P();
+    Double_t pt = trueMomentum.Pt();
+    Double_t theta = trueMomentum.Theta();
+    Double_t eta = trueMomentum.Eta();
+    Double_t mass = trueMomentum.M();
+    Double_t charge = candidate->Charge;
+
+    Bool_t covered = kFALSE;
+    Double_t pathFactor = 0.0; // L = thickness * pathFactor
+
+    if(pTrue > 0.0 && TMath::Abs(TMath::Sin(theta)) > 1.0E-6 && TMath::Abs(TMath::Cos(theta)) > 1.0E-6)
+    {
+      // curler rejection: the helix must reach the outer radius of the barrel
+      Double_t rCurv = pt / (0.3 * TMath::Abs(fBz)); // m, with pt in GeV and B in T
+      Bool_t reaches = (fBz == 0.0) || (2.0 * rCurv > fBarrelRmax);
+
+      // straight-line region assignment (barrel first, then endcaps)
+      Double_t zAtBarrel = fBarrelRmin / TMath::Tan(theta);
+      Double_t rAtEndcap = fEndcapZmin * TMath::Abs(TMath::Tan(theta));
+
+      if(reaches && TMath::Abs(zAtBarrel) <= fBarrelZmax)
+      {
+        covered = kTRUE;
+        pathFactor = 1.0 / TMath::Abs(TMath::Sin(theta));
+      }
+      else if(reaches && rAtEndcap >= fEndcapRmin && rAtEndcap <= fEndcapRmax)
+      {
+        covered = kTRUE;
+        pathFactor = 1.0 / TMath::Abs(TMath::Cos(theta));
+      }
+    }
+
+    if(covered)
+    {
+      Double_t beta = pTrue / TMath::Sqrt(pTrue * pTrue + mass * mass);
+
+      Double_t trueAngle[2], recoAngle[2], sigma[2], npe[2], bend[2];
+      Bool_t usable[2];
+
+      for(int i = 0; i < 2; ++i)
+      {
+        Double_t L = fRad[i].thickness * pathFactor;
+        // direction change of the track across the radiator: 0.3 B L_T / p with L_T the transverse projection [rad]
+        bend[i] = fBendingCoefficient * 0.3 * TMath::Abs(fBz) * L * TMath::Abs(TMath::Sin(theta)) / pTrue;
+        trueAngle[i] = CherenkovAngle(fRad[i], beta);
+        npe[i] = ExpectedNpe(fRad[i], beta, L);
+        if(fPoissonFluctuation && npe[i] > 0.0) npe[i] = gRandom->Poisson(npe[i]);
+
+        DelphesFormula *eff = (i == kGas) ? fGasEfficiency.get() : fAerogelEfficiency.get();
+        Bool_t found = gRandom->Uniform() <= eff->Eval(pt, eta, trueMomentum.Phi(), trueMomentum.E(), candidate);
+
+        usable[i] = (trueAngle[i] > 0.0) && (npe[i] >= fMinPe) && found;
+        recoAngle[i] = -1.0;
+        sigma[i] = -1.0;
+        if(usable[i])
+        {
+          sigma[i] = SigmaTrack(fRad[i], trueAngle[i], npe[i], bend[i]);
+          recoAngle[i] = gRandom->Gaus(trueAngle[i], sigma[i]);
+        }
+      }
+
+      candidate->CherenkovAngleGas = trueAngle[kGas];
+      candidate->CherenkovAngleAerogel = trueAngle[kAerogel];
+      candidate->CherenkovRecoAngleGas = recoAngle[kGas];
+      candidate->CherenkovRecoAngleAerogel = recoAngle[kAerogel];
+      candidate->SigmaThetaCGas = sigma[kGas];
+      candidate->SigmaThetaCAerogel = sigma[kAerogel];
+      candidate->NpeGas = npe[kGas];
+      candidate->NpeAerogel = npe[kAerogel];
+
+      // particle identification: chi2 of the measured angle(s) against pi/K/p
+      // at the reconstructed momentum (or the true one, on request)
+      Double_t pHyp = fUseTrueMomentumForPID ? pTrue : recoMomentum.P();
+      if(pHyp <= 0.0) pHyp = pTrue;
+
+      const Double_t masses[3] = {kMassPi, kMassK, kMassP};
+      const Int_t pdg[3] = {211, 321, 2212};
+      Double_t chi2[3] = {-1.0, -1.0, -1.0};
+      Bool_t anyRing = usable[kGas] || usable[kAerogel];
+
+      if(anyRing)
+      {
+        for(int h = 0; h < 3; ++h)
+        {
+          Double_t betaH = pHyp / TMath::Sqrt(pHyp * pHyp + masses[h] * masses[h]);
+          Double_t c2 = 0.0;
+          for(int i = 0; i < 2; ++i)
+          {
+            Double_t L = fRad[i].thickness * pathFactor;
+            Double_t angH = CherenkovAngle(fRad[i], betaH);
+            Double_t npeH = ExpectedNpe(fRad[i], betaH, L);
+            Bool_t ringExpected = (angH > 0.0) && (npeH >= fMinPe);
+
+            if(usable[i] && ringExpected)
+            {
+              Double_t sigH = SigmaTrack(fRad[i], angH, npeH, bend[i]);
+              Double_t d = (recoAngle[i] - angH) / sigH;
+              c2 += d * d;
+            }
+            else if(usable[i] && !ringExpected)
+            {
+              // a ring was measured where this hypothesis predicts none
+              Double_t d = recoAngle[i] / sigma[i];
+              c2 += d * d;
+            }
+            else if(!usable[i] && ringExpected)
+            {
+              // no ring measured where this hypothesis predicts npeH photons:
+              // -2 ln P(0 | npeH) = 2 npeH
+              c2 += 2.0 * npeH;
+            }
+          }
+          chi2[h] = c2;
+        }
+
+        int best = 0;
+        for(int h = 1; h < 3; ++h)
+          if(chi2[h] < chi2[best]) best = h;
+
+        candidate->ARCchi2Pi = chi2[0];
+        candidate->ARCchi2K = chi2[1];
+        candidate->ARCchi2P = chi2[2];
+        candidate->ARCpid = (charge < 0.0 ? -1 : 1) * pdg[best];
+        candidate->ARCmass = masses[best];
+
+        // hypothesis probabilities from the chi2 values (equal priors):
+        // P_h = exp(-chi2_h/2) / sum_h' exp(-chi2_h'/2), computed relative to the best to avoid underflow
+        Double_t w[3], wsum = 0.0;
+        for(int h = 0; h < 3; ++h)
+        {
+          w[h] = TMath::Exp(-0.5 * (chi2[h] - chi2[best]));
+          wsum += w[h];
+        }
+        candidate->ARCprobPi = w[0] / wsum;
+        candidate->ARCprobK = w[1] / wsum;
+        candidate->ARCprobP = w[2] / wsum;
+      }
+    }
+
+    candidate->AddCandidate(mother);
+    fOutputArray->Add(candidate);
+  }
+}
+
