@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""ARC validation for the ALFA Delphes card.
+
+Reads the Delphes output of the three single-particle gun runs (pi+, K+, p) and
+produces, per radiator:
+  * mean measured Cherenkov angle vs momentum per species,
+  * per-track angular resolution vs momentum,
+  * separation power N_sigma(pi/K) and N_sigma(K/p) vs momentum, with the
+    analytic expectation theta_c = acos(1/(n beta)), sigma = sigma_single/sqrt(N_pe),
+  * the 3-sigma reach in GeV,
+  * the PID confusion matrix (ARCpid vs truth).
+
+Usage:
+  python3 arc_separation.py --pi pip.root --k kp.root --p p.root [--out plots] \
+      [--n-gas 1.0013 --n-aero 1.03 --sig-gas 1.3e-3 --sig-aero 1.5e-3 \
+       --nsat-gas 14 --nsat-aero 7]
+
+Needs ROOT with the Delphes library loadable (libDelphes.so in LD_LIBRARY_PATH).
+"""
+import argparse
+import math
+import os
+import sys
+
+import numpy as np
+
+try:
+    import ROOT
+except ImportError:
+    sys.exit("ROOT is required (source the key4hep stack or your Delphes environment)")
+
+MASS = {"pi": 0.13957039, "K": 0.493677, "p": 0.93827209}
+PDG = {"pi": 211, "K": 321, "p": 2212}
+
+
+def load_tracks(path, label):
+    """Return a dict of numpy arrays with the ARC members of every track."""
+    ROOT.gSystem.Load("libDelphes")
+    f = ROOT.TFile.Open(path)
+    tree = f.Get("Delphes")
+    cols = ["P", "Eta", "CherenkovRecoAngleGas", "CherenkovRecoAngleAerogel",
+            "SigmaThetaCGas", "SigmaThetaCAerogel", "NpeGas", "NpeAerogel", "ARCpid"]
+    data = {c: [] for c in cols}
+    data["label"] = label
+    for ev in tree:
+        for tr in ev.Track:
+            for c in cols:
+                data[c].append(getattr(tr, c))
+    f.Close()
+    return {k: (np.array(v) if k != "label" else v) for k, v in data.items()}
+
+
+def theta_c(n, p, m):
+    beta = p / math.sqrt(p * p + m * m)
+    c = 1.0 / (n * beta)
+    return math.acos(c) if c < 1 else float("nan")
+
+
+def npe(nsat, n, p, m):
+    beta = p / math.sqrt(p * p + m * m)
+    c = 1.0 / (n * beta)
+    if c >= 1:
+        return 0.0
+    return nsat * (1 - c * c) / (1 - 1 / (n * n))
+
+
+def binned(x, y, edges):
+    """Mean and std of y in bins of x (ignoring y < 0)."""
+    means, stds, cnt = [], [], []
+    for lo, hi in zip(edges[:-1], edges[1:]):
+        sel = (x >= lo) & (x < hi) & (y >= 0)
+        if sel.sum() < 5:
+            means.append(np.nan); stds.append(np.nan); cnt.append(sel.sum()); continue
+        means.append(y[sel].mean()); stds.append(y[sel].std()); cnt.append(sel.sum())
+    return np.array(means), np.array(stds), np.array(cnt)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--pi", required=True); ap.add_argument("--k", required=True); ap.add_argument("--p", required=True)
+    ap.add_argument("--out", default="plots")
+    ap.add_argument("--n-gas", type=float, default=1.00132); ap.add_argument("--n-aero", type=float, default=1.02)
+    ap.add_argument("--sig-gas", type=float, default=1.31e-3, help="TOTAL per-photon sigma (non-chromatic (+) chromatic) for the analytic curve"); ap.add_argument("--sig-aero", type=float, default=1.5e-3)
+    ap.add_argument("--nsat-gas", type=float, default=14.0); ap.add_argument("--nsat-aero", type=float, default=7.0)
+    ap.add_argument("--eta-max", type=float, default=0.8, help="barrel-only selection for the separation plots")
+    args = ap.parse_args()
+    os.makedirs(args.out, exist_ok=True)
+
+    import matplotlib
+    matplotlib.use("Agg")
+    import matplotlib.pyplot as plt
+
+    d = {"pi": load_tracks(args.pi, "pi"), "K": load_tracks(args.k, "K"), "p": load_tracks(args.p, "p")}
+    edges = np.logspace(np.log10(0.5), np.log10(60), 25)
+    centers = np.sqrt(edges[:-1] * edges[1:])
+
+    rad = {"gas": ("CherenkovRecoAngleGas", "SigmaThetaCGas", "NpeGas", args.n_gas, args.sig_gas, args.nsat_gas),
+           "aerogel": ("CherenkovRecoAngleAerogel", "SigmaThetaCAerogel", "NpeAerogel", args.n_aero, args.sig_aero, args.nsat_aero)}
+
+    summary = []
+    fig, axes = plt.subplots(1, 2, figsize=(12, 5))
+    for ax, (rname, (ang, sig, npe_col, n, s1, nsat)) in zip(axes, rad.items()):
+        stats = {}
+        for sp in ("pi", "K", "p"):
+            x = d[sp]["P"]; sel = np.abs(d[sp]["Eta"]) < args.eta_max
+            m, s, c = binned(x[sel], d[sp][ang][sel], edges)
+            ms, _, _ = binned(x[sel], d[sp][sig][sel], edges)
+            stats[sp] = (m, ms)
+        for pair, col in ((("pi", "K"), "tab:blue"), (("K", "p"), "tab:orange")):
+            a, b = pair
+            nsig = np.abs(stats[a][0] - stats[b][0]) / np.sqrt(stats[a][1] ** 2 + stats[b][1] ** 2)
+            ax.plot(centers, nsig, "o", color=col, label=f"{a}/{b} Delphes (ARCPID)")
+            # analytic
+            an = []
+            for pc in centers:
+                ta, tb = theta_c(n, pc, MASS[a]), theta_c(n, pc, MASS[b])
+                na, nb = npe(nsat, n, pc, MASS[a]), npe(nsat, n, pc, MASS[b])
+                if any(map(math.isnan, (ta, tb))) or na < 3 or nb < 3:
+                    an.append(np.nan); continue
+                an.append(abs(ta - tb) / math.sqrt(s1 ** 2 / na + s1 ** 2 / nb))
+            an = np.array(an)
+            ax.plot(centers, an, "--", color=col, label=f"{a}/{b} analytic")
+            ok = np.where(np.nan_to_num(nsig) >= 3)[0]
+            reach = centers[ok].max() if ok.size else float("nan")
+            summary.append((rname, f"{a}/{b}", reach))
+        ax.axhline(3, color="grey", ls=":")
+        ax.set_xscale("log"); ax.set_yscale("log"); ax.set_xlabel("p [GeV]"); ax.set_ylabel(r"$N_\sigma$")
+        ax.set_title(f"ARC {rname}: n = {n}, $\\sigma_1$ = {s1*1e3:.2f} mrad, $N_{{sat}}$ = {nsat}")
+        ax.legend(fontsize=8); ax.grid(alpha=0.3)
+    fig.tight_layout(); fig.savefig(os.path.join(args.out, "arc_separation.png"), dpi=150)
+
+    # confusion matrix (barrel + endcap, all p with a ring)
+    print("\nPID confusion (rows: truth, columns: ARCpid = pi, K, p, none), tracks with |eta| < 2.6:")
+    for sp in ("pi", "K", "p"):
+        pid = np.abs(d[sp]["ARCpid"])
+        tot = len(pid)
+        row = [np.sum(pid == PDG[q]) / tot for q in ("pi", "K", "p")] + [np.sum(pid == 0) / tot]
+        print(f"  {sp:3s}  " + "  ".join(f"{v:6.3f}" for v in row))
+
+    print("\n3-sigma reach [GeV] (|eta| < %.1f):" % args.eta_max)
+    for r, pair, reach in summary:
+        print(f"  {r:8s} {pair:5s} {reach:6.1f}")
+    print(f"\nplots in {args.out}/arc_separation.png")
+
+
+if __name__ == "__main__":
+    main()
