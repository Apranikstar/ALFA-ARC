+ *  along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef ARCPID_h
+#define ARCPID_h
+
+/** \class ARCPID
+ *
+ *  Per-track emulation of a dual-radiator RICH built from an Array of RICH
+ *  Cells (ARC): a gas radiator and an aerogel radiator read out by the same
+ *  SiPM plane, as in the ALFA detector concept for FCC-ee.
+ *
+ *  For every charged track that crosses the ARC barrel or one of its endcaps:
+ *   1. path length L through each radiator (full cell depth, L = t/sin(theta)
+ *      in the barrel, L = t/|cos(theta)| in the endcaps); curlers rejected;
+ *   2. true Cherenkov angle cos(theta_c) = 1/(n beta) from the true mass
+ *      and momentum; no ring below threshold;
+ *   3. expected photo-electron yield
+ *      N_pe = N_sat * (L/L_ref) * sin^2(theta_c) / sin^2(theta_c,max);
+ *      a ring is usable when N_pe >= MinPe;
+ *   4. per-track angular resolution sigma = sigma_1/sqrt(N_pe) (+) sigma_track,
+ *      with the per-photon sigma_1^2 = sigma_single^2 + sigma_chrom^2 + sigma_bend^2:
+ *      the chromatic term sigma_chrom = (dn/dE sigma_E) / (n tan theta_c) and the
+ *      bending term sigma_bend = c_bend * 0.3 B L sin(theta) / p (the track direction
+ *      changes along the radiator in the magnetic field; c_bend = 1/sqrt(12) for
+ *      photons emitted uniformly along the path), and a Gaussian-smeared angle;
+ *   5. particle identification: chi^2 of the measured angle(s) against the
+ *      pi, K and p hypotheses at the reconstructed momentum, both radiators
+ *      combined; the smallest chi^2 gives ARCpid and ARCmass, and the
+ *      normalised probabilities P_h = exp(-chi^2_h/2)/sum are stored as
+ *      ARCprobPi/K/P (equal priors; -1 when there is no ring).
+ *
+ *  The parameters n, sigma_single, N_sat and L_ref per radiator are meant to
+ *  be calibrated on the full simulation (k4geo ARC in ALFA_o1_v01).
+ *
+ *  \author ALFA concept group; written from the ARCPID description by
+ *          G. Daniels, S. Pezzulo, M. Defranchis and M. Selvaggi (July 2026).
+ */
+
+#include "classes/DelphesModule.h"
+
+#include <memory>
+
+class TIterator;
+class TObjArray;
+class DelphesFormula;
+
+class ARCPID: public DelphesModule
+{
+public:
+  ARCPID();
+  ~ARCPID();
+
+  void Init();
+  void Process();
+  void Finish();
+
+private:
+  enum Radiator
+  {
+    kGas = 0,
+    kAerogel = 1
+  };
+
+  struct RadiatorParams
+  {
+    Double_t n; // refractive index
+    Double_t sigmaSingle; // single-photon angular resolution, non-chromatic part [rad]
+    Double_t dnde; // dispersion dn/dE at the mean detected photon energy [1/eV]
+    Double_t sigmaE; // rms of the detected photon energy spectrum [eV]
+    Double_t nSat; // photo-electrons at beta = 1 for L = lRef
+    Double_t lRef; // reference path length [m]
+    Double_t thickness; // radial (barrel) / longitudinal (endcap) thickness of the radiator [m]
+    Double_t sin2max; // 1 - 1/n^2
+  };
+
+  // expected yield for a given beta and path length (0 below threshold)
+  Double_t ExpectedNpe(const RadiatorParams &r, Double_t beta, Double_t L) const;
+  // true Cherenkov angle for a given beta (-1 below threshold)
+  Double_t CherenkovAngle(const RadiatorParams &r, Double_t beta) const;
+  // per-photon resolution: non-chromatic part (+) chromatic term dn/dE sigma_E / (n tan theta_c)
+  // (+) track-bending term BendingCoefficient * 0.3 B L sin(theta) / p (emission-point spread in the field)
+  Double_t SigmaSinglePhoton(const RadiatorParams &r, Double_t thetaC, Double_t bend) const;
+  // per-track resolution for npe photons
+  Double_t SigmaTrack(const RadiatorParams &r, Double_t thetaC, Double_t npe, Double_t bend) const;
+
+  // geometry [m]
+  Double_t fBarrelRmin, fBarrelRmax, fBarrelZmax;
+  Double_t fEndcapZmin, fEndcapZmax, fEndcapRmin, fEndcapRmax;
+  Double_t fBz;
+
+  RadiatorParams fRad[2];
+
+  Double_t fMinPe;
+  Double_t fSigmaTrack; // extra angular error from tracking, added in quadrature [rad]
+  Double_t fBendingCoefficient; // per-photon spread from the track curving inside the radiator, in units of the total deflection (1/sqrt(12) for uniform emission); 0 = off
+  Bool_t fPoissonFluctuation; // fluctuate the yield per track
+  Bool_t fUseTrueMomentumForPID; // hypotheses evaluated at the true instead of the reconstructed momentum
+
+  std::unique_ptr<DelphesFormula> fGasEfficiency; //! ring-finding efficiency, gas (eta, pt)
+  std::unique_ptr<DelphesFormula> fAerogelEfficiency; //! ring-finding efficiency, aerogel (eta, pt)
+
+  std::unique_ptr<TIterator> fItInputArray; //!
+  const TObjArray *fInputArray = nullptr; //!
+  TObjArray *fOutputArray = nullptr; //!
+
+  ClassDef(ARCPID, 1)
+};
+
+#endif
