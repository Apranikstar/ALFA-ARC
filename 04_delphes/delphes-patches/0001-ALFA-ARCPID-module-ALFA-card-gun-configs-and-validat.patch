+#########################################
+# ARC: Array of RICH Cells, per-track PID
+#########################################
+
+module ARCPID ARCPID {
+  set InputArray TrackSmearing/tracks
+  set OutputArray tracks
+
+  set Bz $::B
+
+  ## ARC envelope [m]
+  set BarrelRmin $::ARCBRMIN
+  set BarrelRmax $::ARCBRMAX
+  set BarrelZmax $::ARCBZMAX
+  set EndcapZmin $::ARCEZMIN
+  set EndcapZmax $::ARCEZMAX
+  set EndcapRmin $::ARCERMIN
+  set EndcapRmax $::ARCERMAX
+
+  ## gas radiator: xenon at 2 bar, 293.15 K. Numbers from the k4geo full simulation (standalone ARC cell, per-photon
+  ## reconstruction, lxplus 29 Oct 2026): n and dn/dE at the PDE-weighted mean detected photon energy <E> = 3.02 eV,
+  ## sigma_E = rms of the detected spectrum. Thresholds pi/K/p = 2.71 / 9.59 / 18.2 GeV follow from n.
+  set GasRefractiveIndex 1.00132
+  set GasDnDe 6.17E-5
+  set GasSigmaE 0.676
+  ## non-chromatic per-photon resolution [rad] = sqrt(sigma1^2 - chromatic^2) with sigma1 = 2.4 mrad measured, chromatic 0.81 mrad
+  set GasSigmaSingle 2.25E-3
+  ## photo-electrons at beta = 1 for a path GasLref: placeholder (ARCPID Jul 2026), task T12 replaces it
+  set GasNsat 14.0
+  set GasLref 0.15
+  ## metres of gas crossed at normal incidence (T12 measures the real path through the cells)
+  set GasThickness 0.15
+
+  ## aerogel radiator (k4geo Aerogel_PFRICH as used in the full sim; design value n = 1.03 is being reconciled with the group)
+  set AerogelRefractiveIndex 1.0193
+  # set AerogelRefractiveIndex 1.03   ;# design value
+  ## aerogel is strongly dispersive: chromatic term ~2.6 mrad dominates; sigma1 measured 3.4-3.8 mrad
+  set AerogelDnDe 7.9E-4
+  set AerogelSigmaE 0.676
+  set AerogelSigmaSingle 2.4E-3
+  set AerogelNsat 7.0
+  set AerogelLref 0.01
+  set AerogelThickness 0.01
+
+  ## Per-photon error from the track curving inside the radiator (3 T, 15 cm gas: ~4 mrad at 10 GeV, seen in full ALFA):
+  ## sigma_bend = BendingCoefficient * 0.3 * B * L * sin(theta) / p, with 1/sqrt(12) = 0.2887 for uniform emission; 0 switches it off
+  set BendingCoefficient 0.2887
+
+  ## a ring needs at least MinPe expected photo-electrons
+  set MinPe 3.0
+  ## tracking contribution to the angle, added in quadrature [rad]
+  set SigmaTrack 0.0
+  ## fluctuate the yield per track (false reproduces the ARCPID study)
+  set PoissonFluctuation false
+  ## evaluate the pi/K/p hypotheses at the true momentum instead of the smeared one
+  set UseTrueMomentumForPID false
+
+  ## ring-finding efficiency vs (pt, eta); 1.0 = geometric acceptance only.
+  ## To be filled from full sim (task T06): barrel-endcap crack at |cos theta| ~ 0.73, ring-off-sensor losses.
+  set GasEfficiencyFormula { 1.0 }
+  set AerogelEfficiencyFormula { 1.0 }
+}
