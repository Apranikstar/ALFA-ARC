From 22aa3113d7c895f57569e92ad4e98720b689084a Mon Sep 17 00:00:00 2001
From: apranikstar <trialoftheniku@gmail.com>
Date: Fri, 30 Oct 2026 12:14:54 +0100
Subject: [PATCH 12/12] ALFA C4F10 card: ARC passive layers with the C4F10
 radiation length

The tracker table came from the xenon template, so the C4F10 card had the xenon ARC (20 cm, X0 3.45 m, 5.8% X0 at
90 deg). The k4geo scan with C4F10 gives 4.19% -> X0 4.78 m (barrel and both endcaps). make_cards.py sets it per gas.
The layers lie outside the last measurement, so the track covariance is unchanged (checked on the full p-theta grid):
the v4 validation stands. Xe card unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KP5vqAGH2XiGXWtPhaonke
---
 cards/delphes_card_ALFA_C4F10.tcl |  8 ++++----
 examples/ALFA/make_cards.py       | 21 +++++++++++++++++++++
 2 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/cards/delphes_card_ALFA_C4F10.tcl b/cards/delphes_card_ALFA_C4F10.tcl
index a8f02c0..244add2 100644
--- a/cards/delphes_card_ALFA_C4F10.tcl
+++ b/cards/delphes_card_ALFA_C4F10.tcl
@@ -273,8 +273,8 @@ module TrackCovariance TrackSmearing {
       1 OTB -1.345 1.345 1.64 0.0001874 0.0937 2 0 1.5708 3e-06 3e-06 1
       1 OTB -1.345 1.345 1.714 0.0002436 0.0937 2 0 1.5708 3e-06 3e-06 1
       1 OTB -1.345 1.345 1.767 0.0002436 0.0937 2 0 1.5708 3e-06 3e-06 1
-      # ARC barrel as passive material: 20 cm, 5.8% X0 at 90 deg (k4geo T04 material scan)
-      1 ARCB -2.2 2.2 2 0.2 3.45 0 0 0 0 0 0
+      # ARC barrel as passive material: 20 cm, 4.2% X0 at 90 deg with C4F10 (k4geo T04 material scan)
+      1 ARCB -2.2 2.2 2 0.2 4.78 0 0 0 0 0 0
       # outer tracker endcaps: 4 double disks per side (ALFA Delphes card, Jul 2026; engineering design in progress)
       2 OTE 0.15 1.78 -2.045 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
       2 OTE 0.15 1.78 -1.995 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
@@ -293,8 +293,8 @@ module TrackCovariance TrackSmearing {
       2 OTE 0.15 1.78 1.995 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
       2 OTE 0.15 1.78 2.045 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
       # ARC endcaps as passive material
-      2 ARCE 0.28 1.9 -2.1 0.2 3.45 0 0 0 0 0 0
-      2 ARCE 0.28 1.9 2.1 0.2 3.45 0 0 0 0 0 0
+      2 ARCE 0.28 1.9 -2.1 0.2 4.78 0 0 0 0 0 0
+      2 ARCE 0.28 1.9 2.1 0.2 4.78 0 0 0 0 0 0
 
     }
 
diff --git a/examples/ALFA/make_cards.py b/examples/ALFA/make_cards.py
index c1f68b5..4aa36da 100644
--- a/examples/ALFA/make_cards.py
+++ b/examples/ALFA/make_cards.py
@@ -101,6 +101,25 @@ GAS_HDR = {
   set GasDnDe 2.25E-5
   set GasSigmaE 0.667
 """}
+# ARC passive material in the TrackCovariance table (outside the last measurement: no effect on the track fit, kept right
+# for bookkeeping). X0 of the 20 cm ARC layer from the k4geo material scan at 90 deg: Xe 2 bar 5.84 % -> 3.45 m (template),
+# C4F10 4.19 % -> 4.78 m (T04 scan, gas layer scaled by X0_Xe / X0_C4F10; T17 material comparison).
+ARC_X0 = {"C4F10": 4.78}
+
+
+def arc_material(card, x0):
+    lines = []
+    for l in card.split("\n"):
+        x = l.split()
+        if len(x) >= 13 and x[1] in ("ARCB", "ARCE") and not l.lstrip().startswith("#"):
+            x[6] = f"{x0:g}"
+            l = "      " + " ".join(x)
+        elif "# ARC barrel as passive material" in l:
+            l = l.replace("5.8% X0 at 90 deg", "4.2% X0 at 90 deg with C4F10")
+        lines.append(l)
+    return "\n".join(lines)
+
+
 for v in (sys.argv[1:] or ["Xe2bar", "C4F10"]):
     own = os.path.exists(CALIB[v])
     CAL = json.load(open(CALIB[v] if own else CALIB["Xe2bar"]))
@@ -157,6 +176,8 @@ for v in (sys.argv[1:] or ["Xe2bar", "C4F10"]):
             f"no C4F10 full sim yet: Xe calibration, non-chromatic part x {C4F10_NONCHROM} (two standalone cells).")
     block = block.replace("@C4F10_CALIB@", note)
     out = src[:i] + block + src[j:]
+    if v != "Xe2bar":  # ARC passive layers in the tracker table: 20 cm with the X0 of the card's gas (template: xenon 2 bar)
+        out = arc_material(out, ARC_X0[v])
     out = f"# ALFA Delphes card, ARC gas variant: {v} (generated by examples/ALFA/make_cards.py from delphes_card_ALFA_template.tcl, calibration v4: reconstruction v2, T17)\n" + out
     open(f"cards/delphes_card_ALFA_{v}.tcl", "w").write(out)
     print(v, "written; BendingCoefficient", round(K_BEND, 3))
-- 
