+#########################################
+# ARC: Array of RICH Cells, per-track PID
+#########################################
+
+module ARCPID ARCPID {
+  set InputArray TrackSmearing/tracks
+  set OutputArray tracks
+
+  set Bz $::B
+
+  ## ARC envelope [m]
+  set BarrelRmin $::ARCBRMIN
+  set BarrelRmax $::ARCBRMAX
+  set BarrelZmax $::ARCBZMAX
+  set EndcapZmin $::ARCEZMIN
+  set EndcapZmax $::ARCEZMAX
+  set EndcapRmin $::ARCERMIN
+  set EndcapRmax $::ARCERMAX
+
+  ## gas radiator: xenon at 2 bar, 293.15 K (k4geo Xenon_ARC, ALFA_o1_v01). n and dn/dE at the PDE-weighted mean detected photon
+  ## energy <E> = 3.02 eV (T11prep), sigma_E = rms of the detected gas spectrum (T12). Thresholds pi/K/p = 2.71 / 9.59 / 18.2 GeV.
+  set GasRefractiveIndex 1.00132
+  set GasDnDe 6.17E-5
+  set GasSigmaE 0.68
+  ## per-photon resolution without the chromatic part [rad] (pixel 1.25 (+) emission), cell-averaged full sim (T06b), smooth in the
+  ## cell off-axis variable; even-polynomial fits (s1^2 and s_c^2 in mrad^2, chromatic included in s1 and removed here; Y; E).
+  ## Residuals of the smooth forms around the cell-averaged points: s1 <= 2%, s_c 3-9%, Y and E <= 3.6% rms (systematic):
+  ##   s1_barrel: even polynomial in x, c = 9.687, 10.62, -9.808 (chi2/ndf 1.06, x in [0.064, 0.963])
+  ##   s1_endcap: even polynomial in x, c = 8.703, 6.007 (chi2/ndf 0.97, x in [0.237, 0.777])
+  ##   sc_barrel: even polynomial in x, c = 0.5226, 2.588, -2.254 (chi2/ndf 0.27, x in [0.064, 0.963])
+  ##   sc_endcap: even polynomial in x, c = 0.2339, 1.453 (chi2/ndf 1.50, x in [0.237, 0.777])
+  ##   Y_barrel: even polynomial in x, c = 0.981, -1.274, 2.311, -1.276 (chi2/ndf 7.72, x in [0.064, 0.963])
+  ##   Y_endcap: even polynomial in x, c = 1.013, -0.5319, 0.4176 (chi2/ndf 0.44, x in [0.237, 0.777])
+  ##   E_barrel: even polynomial in x, c = 0.9929, -0.3013, 0.1644 (chi2/ndf 2.89, x in [0.064, 0.963])
+  ##   E_endcap: even polynomial in x, c = 1.019, -0.3722 (chi2/ndf 2.44, x in [0.237, 0.777])
+  set GasSigmaSingle 0.003005
+  set GasSigmaSingleFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (9.68685) + (10.6206) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (-9.8085) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4) - (0.6561)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.004956) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (8.70341) + (6.00713) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) - (0.6561))))
+  }
+  ## per-track correlated term [rad] (does not average down with N_pe): cell-position-dependent bias of the optics
+  set GasSigmaCorrFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (0.522559) + (2.58791) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (-2.2542) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4) - (0)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.001513) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (0.233946) + (1.45306) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) - (0))))
+  }
+  ## photons at beta = 1 for L = L_ref at normal incidence (cell-averaged); ideal mirror, x 0.90 for a 90% mirror (T07)
+  set GasNsat 10.43
+  set GasLref 0.15
+  ## gas crossed at normal incidence through the k4geo cells (T12 part A): 16.9 cm barrel, 16.7 cm endcap
+  set GasThickness 0.169
+  ## light collection relative to the path scaling N_sat L / L_ref (photons leave the cell at oblique incidence)
+  set GasYieldScaleFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, (0.980987) + (-1.27425) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (2.31081) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4) + (-1.27586) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 6))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.4963) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, (1.0131) + (-0.531886) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) + (0.417578) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 4)))
+  }
+
+  ## aerogel radiator: k4geo Aerogel_PFRICH (design value 1.03 not used by the full sim). n and dn/dE at the detected <E> = 3.0 eV,
+  ## sigma_E = rms of the detected aerogel spectrum (T12, 90 deg). The chromatic term (2.7 mrad at beta = 1) dominates.
+  set AerogelRefractiveIndex 1.0193
+  # set AerogelRefractiveIndex 1.03   ;# design value
+  set AerogelDnDe 7.9E-4
+  set AerogelSigmaE 0.655
+  ## per-photon resolution without the chromatic part [rad] (pixel 1.23 (+) emission); fits (mrad, chromatic included):
+  ##   s1_barrel: even polynomial in x, c = 8.352, 3.638 (chi2/ndf 1.08, x in [0.064, 0.963])
+  ##   s1_endcap: even polynomial in x, c = 8.406, 2.597 (chi2/ndf 3.59, x in [0.237, 0.777])
+  ##   sc_barrel: even polynomial in x, c = 1.584, 9.535, 9.948 (chi2/ndf 5.76, x in [0.064, 0.963])
+  ##   sc_endcap: even polynomial in x, c = 0.3133, 12.79 (chi2/ndf 3.20, x in [0.237, 0.777])
+  ##   Y_barrel: even polynomial in x, c = 0.9819, 0.7645, -1.315, 0.6602 (chi2/ndf 0.94, x in [0.064, 0.963])
+  ##   Y_endcap: even polynomial in x, c = 1.064, 0.2568, -0.6336 (chi2/ndf 1.56, x in [0.237, 0.777])
+  ##   E_barrel: even polynomial in x, c = 0.9354, -0.3339, 0.3892 (chi2/ndf 12.22, x in [0.064, 0.963])
+  ##   E_endcap: even polynomial in x, c = 0.9628, -0.121 (chi2/ndf 1.69, x in [0.237, 0.777])
+  set AerogelSigmaSingle 0.001082
+  set AerogelSigmaSingleFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (8.35225) + (3.63775) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) - (7.1824)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.001545) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (8.40626) + (2.59701) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) - (7.1824))))
+  }
+  set AerogelSigmaCorrFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (1.58429) + (9.53458) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (9.94849) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4) - (0)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.003702) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (0.313326) + (12.7915) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) - (0))))
+  }
+  set AerogelNsat 6.94
+  set AerogelLref 0.01
+  set AerogelThickness 0.0098
+  set AerogelYieldScaleFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, (0.98185) + (0.764474) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (-1.31534) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4) + (0.660188) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 6))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.7548) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, (1.06379) + (0.25676) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2) + (-0.633595) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 4)))
+  }
+
+  ## per-photon spread from the track curving across the radiator: sigma_bend = BendingCoefficient * 0.3 * B * L * sin(theta) / p,
+  ## weighted mean of the per-bin gas fits (T06b); the T06 reconstruction already corrects for the helix, so k < 1/sqrt(12)
+  set BendingCoefficient 0.155
+
+  ## a ring needs at least MinPe detected photons (as in the T06 reconstruction); the yield fluctuates per track (Poisson)
+  set MinPe 3.0
+  set SigmaTrack 0.0
+  set PoissonFluctuation true
+  set UseTrueMomentumForPID false
+
+  ## ring-finding efficiency (ring lost: cell edge, mirror gap; < 3 photons is handled by MinPe), cell-averaged
+  set GasEfficiencyFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, TMath::Min(1.0, (0.992905) + (-0.301298) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (0.164372) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.123) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, TMath::Min(1.0, (1.01939) + (-0.372212) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2))))
+  }
+  set AerogelEfficiencyFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, TMath::Min(1.0, (0.935369) + (-0.333916) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 2) + (0.389179) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0637), 0.9627), 4)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.1865) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, TMath::Min(1.0, (0.962775) + (-0.121011) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2373), 0.7765), 2))))
+  }
+}
+
+##############
+# Track merger
+##############
+
+module Merger TrackMerger {
+# add InputArray InputArray
+  add InputArray ARCPID/tracks
+  set OutputArray tracks
+}
+
+
+######################
+# Looper Selection
+######################
+
+module Efficiency ForwardLooperTracks  {
+  set InputArray TrackMerger/tracks
+  set OutputArray tracks
+  set UseMomentumVector false
+
+  ## select looping tracks that end up in position |eta| > 3.142 (lost by calo)
+  set EfficiencyFormula {
+    (abs(eta) > 3.0 )                                 * (1.000) +
+    (abs(eta) <= 3.0 )                                * (0.000)
+  }
+
+}
+
+
+#############
+# Calorimeter
+#############
+module DualReadoutCalorimeter Calorimeter {
+    set ParticleInputArray ParticlePropagator/stableParticles
+    set TrackInputArray TrackMerger/tracks
+
+    set TowerOutputArray towers
+    set PhotonOutputArray photons
+
+    set EFlowTrackOutputArray eflowTracks
+    set EFlowPhotonOutputArray eflowPhotons
+    set EFlowNeutralHadronOutputArray eflowNeutralHadrons
+
+    set ECalMinSignificance 2.0
+    set HCalMinSignificance 2.5
+
+    set SmearLogNormal false
+
+    set SmearTowerCenter true
+    #set SmearTowerCenter false
+
+    ## GRAiNITA barrel photon angular resolution, CLUE clustering (ALFA Reco workshop 26 Oct 2026): a = 0.80, b = 0.55, c = 0.145 mrad; endcap assumed equal
+    set PhotonAngularSmearing true
+
+    set PhotonThetaResolutionFormula {
+      (abs(eta) <= 0.92)                   * sqrt(0.80^2/energy + 0.55^2/energy^2 + 0.145^2)*1E-3 +
+      (abs(eta) > 0.92 && abs(eta) <= 3.0) * sqrt(0.80^2/energy + 0.55^2/energy^2 + 0.145^2)*1E-3
+    }
+
+    set PhotonPhiResolutionFormula {
+      (abs(eta) <= 0.92)                   * sqrt(0.80^2/energy + 0.55^2/energy^2 + 0.145^2)*1E-3 +
+      (abs(eta) > 0.92 && abs(eta) <= 3.0) * sqrt(0.80^2/energy + 0.55^2/energy^2 + 0.145^2)*1E-3
+    }
+
+    set PhotonPointing true
+
+    set PointingThetaResolutionFormula { (abs(eta) <= 3.0) * sqrt(111.9^2/energy + 21.0^2)*1E-3 }
+    set PointingPhiResolutionFormula   { (abs(eta) <= 3.0) * sqrt(139.4^2/energy + 23.8^2)*1E-3 }
+
+    ## alternative optimistic pointing BDT-corrected
+    # set PointingThetaResolutionFormula { (abs(eta) <= 3.0) * sqrt(51.76^2/energy + 11.67^2)*1E-3 }
+    # set PointingPhiResolutionFormula   { (abs(eta) <= 3.0) * sqrt(75.76^2/energy + 73.66^2/energy^2 + 16.73^2)*1E-3 }
+    set pi [expr {acos(-1)}]
+
+    # Lists of the edges of each tower in eta and phi;
+    # each list starts with the lower edge of the first tower;
+    # the list ends with the higher edged of the last tower.
+    # Barrel:  deta=0.02 towers up to |eta| <= 0.88 ( up to 45°)
+    # Endcaps: deta=0.02 towers up to |eta| <= 3.0 (8.6° = 100 mrad)
+    # Cell size: about 6 cm x 6 cm
+
+    set EtaPhiRes 0.02
+    set EtaMax 3.0
+
+    set pi [expr {acos(-1)}]
+
+    set PhiBins [expr {int($pi/$EtaPhiRes) * 2}]
+
+    set nbins_eta [expr {$EtaMax/$EtaPhiRes} ]
+    set nbins_eta [expr {int($nbins_eta)} ]
+
+    for {set i -$nbins_eta} {$i <= $nbins_eta} {incr i} {
+      set eta [expr {$i * $EtaPhiRes}]
+      add EtaPhiBins $eta $PhiBins
+    }
+
+    # default energy fractions {abs(PDG code)} {Fecal Fhcal}
+    add EnergyFraction {0} {0.0 1.0}
+    # energy fractions for e, gamma and pi0
+    add EnergyFraction {11} {1.0 0.0}
+    add EnergyFraction {22} {1.0 0.0}
+    add EnergyFraction {111} {1.0 0.0}
+    # energy fractions for muon, neutrinos and neutralinos
+    add EnergyFraction {12} {0.0 0.0}
+    add EnergyFraction {13} {0.0 0.0}
+    add EnergyFraction {14} {0.0 0.0}
+    add EnergyFraction {16} {0.0 0.0}
+    add EnergyFraction {1000022} {0.0 0.0}
+    add EnergyFraction {1000023} {0.0 0.0}
+    add EnergyFraction {1000025} {0.0 0.0}
+    add EnergyFraction {1000035} {0.0 0.0}
+    add EnergyFraction {1000045} {0.0 0.0}
+    # energy fractions for K0short and Lambda
+    add EnergyFraction {310} {0.3 0.7}
+    add EnergyFraction {130} {0.3 0.7}
+    add EnergyFraction {3122} {0.3 0.7}
+
+
+    ## GRAiNITA ECAL: sigma_E/E = 1.7%/sqrt(E) (+) 1.1% at reconstruction level with CLUE (ALFA Reco workshop 26 Oct 2026).
+    ## Endcap assumed identical (no endcap design yet).
+    set ECalResolutionFormula {
+    (abs(eta) <= 0.92 )                     * sqrt(energy^2*0.011^2 + energy*0.017^2 + 0.002^2)+
+    (abs(eta) > 0.92 && abs(eta) <= 3.0)    * sqrt(energy^2*0.011^2 + energy*0.017^2 + 0.002^2)
+    }
+
+
+    ## HCAL: SiPM-on-tile scintillator in the instrumented yoke (HGCAL CE-H like).
+    ## PLACEHOLDER: 45%/sqrt(E) (+) 3% (CALICE AHCAL-like) until the standalone Geant4 study provides numbers.
+    set HCalResolutionFormula {
+    (abs(eta) <= 0.92 )                     * sqrt(energy^2*0.03^2 + energy*0.45^2 + 0.05^2)+
+    (abs(eta) > 0.92 && abs(eta) <= 3.0)    * sqrt(energy^2*0.03^2 + energy*0.45^2 + 0.05^2)
+    }
+}
+
+########################################
+#   Time Smearing Neutrals
+########################################
+
+module TimeSmearing TimeSmearingNeutrals {
+  set InputArray Calorimeter/eflowNeutralHadrons
+  set OutputArray eflowNeutralHadrons
+
+  # assume constant 30 ps resolution for now
+  set TimeResolution {
+                       (abs(eta) > 0.0 && abs(eta) <= 3.0)* 30E-12
+                     }
+}
+
+########################################
+#   Time Of Flight Measurement
+########################################
+
+module TimeOfFlight TimeOfFlightNeutralHadron {
+  set InputArray TimeSmearingNeutrals/eflowNeutralHadrons
+  set VertexInputArray TruthVertexFinder/vertices
+
+  set OutputArray eflowNeutralHadrons
+
+  # 0: assume vertex time tV from MC Truth (ideal case)
+  # 1: assume vertex time tV = 0
+  # 2: calculate vertex time as vertex TOF, assuming tPV=0
+
+  ## TBF (add option to take hard vertex time)
+  set VertexTimeMode 1
+}
+
+
+############################
+# Energy flow track merger
+############################
+
+module Merger EFlowTrackMerger {
+# add InputArray InputArray
+  add InputArray Calorimeter/eflowTracks
+  add InputArray ForwardLooperTracks/tracks
+  set OutputArray eflowTracks
+}
+
+
+
+####################
+# Energy flow merger
+####################
+
+module Merger EFlowMerger {
+# add InputArray InputArray
+  add InputArray EFlowTrackMerger/eflowTracks
+  add InputArray Calorimeter/eflowPhotons
+  add InputArray TimeOfFlightNeutralHadron/eflowNeutralHadrons
+  set OutputArray eflow
+}
+
+
+####################
+# Tower merger
+####################
+
+module Merger TowerMerger {
+# add InputArray InputArray
+  add InputArray Calorimeter/towers
+  add InputArray MuonFilter/muons
+  set OutputArray towers
+}
+
+
+###################
+# Photon efficiency
+###################
+
+module Efficiency PhotonEfficiency {
+  set InputArray Calorimeter/eflowPhotons
+  set OutputArray photons
+
+  # set EfficiencyFormula {efficiency formula as a function of eta and pt}
+  # efficiency formula for photons
+  set EfficiencyFormula {
+        (energy < 2.0)                                        * (0.000)+
+        (energy >= 2.0) * (abs(eta) <= 0.92)                  * (0.99) +
+        (energy >= 2.0) * (abs(eta) >0.88 && abs(eta) <= 3.0) * (0.99) +
+        (abs(eta) > 3.0)                                      * (0.000)
+  }
+}
+
+##################
+# Photon isolation
+##################
+
+module Isolation PhotonIsolation {
+  set CandidateInputArray PhotonEfficiency/photons
+  set IsolationInputArray EFlowMerger/eflow
+
+  set OutputArray photons
+
+  set DeltaRMax 0.5
+
+  set PTMin 0.5
+
+  set PTRatioMax 9999.
+}
+
+#################
+# Electron filter
+#################
+
+module PdgCodeFilter ElectronFilter {
+  set InputArray EFlowTrackMerger/eflowTracks
+  set OutputArray electrons
+  set Invert true
+  add PdgCode {11}
+  add PdgCode {-11}
+}
+
+#################
+# Muon filter
+#################
+
+module PdgCodeFilter MuonFilter {
+  set InputArray EFlowTrackMerger/eflowTracks
+  set OutputArray muons
+  set Invert true
+  add PdgCode {13}
+  add PdgCode {-13}
+}
+
+
+#####################
+# Electron efficiency
+#####################
+
+module Efficiency ElectronEfficiency {
+  set InputArray ElectronFilter/electrons
+  set OutputArray electrons
+
+  # set EfficiencyFormula {efficiency formula as a function of eta and pt}
+
+  # efficiency formula for electrons
+  set EfficiencyFormula {
+        (energy < 2.0)                                         * (0.000)+
+        (energy >= 2.0) * (abs(eta) <= 0.92)                   * (0.99) +
+        (energy >= 2.0) * (abs(eta) >0.88 && abs(eta) <= 3.0)  * (0.99) +
+        (abs(eta) > 3.0)                                       * (0.000)
+  }
+}
+
+####################
+# Electron isolation
+####################
+
+module Isolation ElectronIsolation {
+  set CandidateInputArray ElectronEfficiency/electrons
+  set IsolationInputArray EFlowMerger/eflow
+
+  set OutputArray electrons
+
+  set DeltaRMax 0.5
+
+  set PTMin 0.5
+
+  set PTRatioMax 9999
+}
+
+#################
+# Muon efficiency
+#################
+
+module Efficiency MuonEfficiency {
+  set InputArray MuonFilter/muons
+  set OutputArray muons
+
+  # set EfficiencyFormula {efficiency as a function of eta and pt}
+
+  # efficiency formula for muons
+  set EfficiencyFormula {
+        (energy < 2.0)                                         * (0.000)+
+        (energy >= 2.0) * (abs(eta) <= 0.92)                   * (0.99) +
+        (energy >= 2.0) * (abs(eta) >0.88 && abs(eta) <= 3.0)  * (0.99) +
+        (abs(eta) > 3.0)                                       * (0.000)
+  }
+}
+
+################
+# Muon isolation
+################
+
+module Isolation MuonIsolation {
+  set CandidateInputArray MuonEfficiency/muons
+  set IsolationInputArray EFlowMerger/eflow
+
+  set OutputArray muons
+
+  set DeltaRMax 0.5
+
+  set PTMin 0.5
+
+  set PTRatioMax 9999.
+}
+
+###################
+# Missing ET merger
+###################
+
+module Merger MissingET {
+# add InputArray InputArray
+  add InputArray EFlowMerger/eflow
+  set MomentumOutputArray momentum
+}
+
+
+#####################
+# Neutrino Filter
+#####################
+
+module PdgCodeFilter NeutrinoFilter {
+
+  set InputArray Delphes/stableParticles
+  set OutputArray filteredParticles
+
+  set PTMin 0.0
+
+  add PdgCode {12}
+  add PdgCode {14}
+  add PdgCode {16}
+  add PdgCode {-12}
+  add PdgCode {-14}
+  add PdgCode {-16}
+}
+
+###################################
+# Gen Jet finder Durham exclusive
+###################################
+
+module FastJetFinder GenJetFinderDurhamN2 {
+
+  set InputArray NeutrinoFilter/filteredParticles
+  set OutputArray jets
+
+  # algorithm: 11 ee-durham kT algorithm
+  # ref: https://indico.cern.ch/event/1173562/contributions/4929025/attachments/2470068/4237859/2022-06-FCC-jets.pdf
+  # to run exclusive njet mode set NJets to int
+  # to run exclusive dcut mode set DCut to float
+  # if DCut > 0 will run in dcut mode
+
+  set JetAlgorithm 11
+  set ExclusiveClustering true
+  set NJets 2
+  # set DCut 10.0
+}
+
+################################
+# Jet finder Durham exclusive
+################################
+
+module FastJetFinder FastJetFinderDurhamN2 {
+#  set InputArray Calorimeter/towers
+  set InputArray EFlowMerger/eflow
+
+  set OutputArray jets
+
+  # algorithm: 11 ee-durham kT algorithm
+  # ref: https://indico.cern.ch/event/1173562/contributions/4929025/attachments/2470068/4237859/2022-06-FCC-jets.pdf
+  # to run exclusive njet mode set NJets to int
+  # to run exclusive dcut mode set DCut to float
+  # if DCut > 0 will run in dcut mode
+
+  set JetAlgorithm 11
+  set ExclusiveClustering true
+  set NJets 2
+  # set DCut 10.0
+
+}
+
+
+
+
+#####################
+# MC truth jet finder
+#####################
+
+module FastJetFinder GenJetFinder {
+  set InputArray NeutrinoFilter/filteredParticles
+  set OutputArray jets
+
+  set JetAlgorithm 10
+  set ParameterR 1.5
+  set ParameterP -1.0
+  set JetPTMin 1.0
+
+}
+
+
+#########################
+# Gen Missing ET merger
+########################
+
+module Merger GenMissingET {
+# add InputArray InputArray
+  add InputArray NeutrinoFilter/filteredParticles
+  set MomentumOutputArray momentum
+}
+
+############
+# Jet finder
+############
+
+module FastJetFinder FastJetFinder {
+#  set InputArray Calorimeter/towers
+  set InputArray EFlowMerger/eflow
+
+  set OutputArray jets
+
+  # algorithm: 1 CDFJetClu, 2 MidPoint, 3 SIScone, 4 kt, 5 Cambridge/Aachen, 6 antikt
+  set JetAlgorithm 10
+  set ParameterR 1.5
+  set ParameterP -1.0
+  set JetPTMin 1.0
+
+
+}
+
+##################
+# Jet Energy Scale
+##################
+
+module EnergyScale JetEnergyScale {
