+# ALFA Delphes card, ARC gas variant: C4F10 (generated by examples/ALFA/make_cards.py from delphes_card_ALFA.tcl, calibration v3)
+set RandomSeed 123
+
+#####################################################################
+# FCC-ee ALFA detector model  (ALFA_o1_v01-like, with ARC PID)
+#
+# Derived from the IDEA card. Tracker, ARC and ECAL numbers follow the
+# ALFA full simulation in k4geo (FCCee/ALFA/compact/ALFA_o1_v01) and the
+# ALFA talks of Oct 2026 (Reco workshop 26 Oct, ARC pre-demonstrator 16 Oct).
+#
+#   tracker : all-MAPS. 5-layer vertex (r = 1.3-3.3 cm, 140 mrad acceptance,
+#             3 um), 4 double-layer barrel stations (r = 0.77-1.77 m, 3 um,
+#             0.2% X0 per plane), 4 double disks per side (|z| = 1.39-2.02 m)
+#   ARC     : barrel r = 1.90-2.10 m, endcaps |z| = 2.00-2.20 m, Xe 2 bar +
+#             1 cm aerogel; 5.8% X0 passive material in the track fit
+#   ECAL    : GRAiNITA, 1.7%/sqrt(E) (+) 1.1%, 0.2 mrad angular at high E
+#   HCAL    : SiPM-on-tile in the yoke; resolution is a PLACEHOLDER
+#   B field : 3 T
+#
+# ARC parameters (ARCPID module) are the first-pass values of the ARCPID
+# study (Daniels et al., Jul 2026) and are to be replaced by the k4geo
+# full-sim calibration (tasks T05/T06 on the ALFA ARC task board).
+#####################################################################
+
+set B 3.0
+## inner radius / half length of the ECAL = where track propagation stops [m]
+set R 2.20
+set HL 2.30
+
+## ARC envelope [m], as in k4geo ALFA_o1_v01
+set ARCBRMIN 1.90
+set ARCBRMAX 2.10
+set ARCBZMAX 2.20
+set ARCEZMIN 2.00
+set ARCEZMAX 2.20
+set ARCERMIN 0.28
+set ARCERMAX 1.90
+
+
+#######################################
+# Order of execution of various modules
+#######################################
+
+set ExecutionPath {
+
+  BeamSpotSmearing
+
+  TruthVertexFinder
+  ParticlePropagator
+
+  ChargedHadronTrackingEfficiency
+  ElectronTrackingEfficiency
+  MuonTrackingEfficiency
+
+  TrackMergerPre
+  TrackSmearing
+  ARCPID
+
+  TrackMerger
+  ForwardLooperTracks
+  Calorimeter
+
+  TimeSmearingNeutrals
+  TimeOfFlightNeutralHadron
+
+  EFlowTrackMerger
+  EFlowMerger
+
+  PhotonEfficiency
+  PhotonIsolation
+
+  MuonFilter
+  TowerMerger
+
+  ElectronFilter
+  ElectronEfficiency
+  ElectronIsolation
+
+  MuonEfficiency
+  MuonIsolation
+
+  MissingET
+
+  NeutrinoFilter
+  GenJetFinder
+  GenMissingET
+
+  FastJetFinder
+  JetEnergyScale
+
+  GenJetFinderDurhamN2
+  FastJetFinderDurhamN2
+
+  JetFlavorAssociation
+
+  BTagging
+  CTagging
+  TauTagging
+
+  TreeWriter
+}
+
+#################################
+# Beam spot smearing
+#################################
+
+module BeamSpotSmearing BeamSpotSmearing {
+
+  set InputArray Delphes/allParticles
+
+  # beam spot size in x, y, z [m] and bunch time spread [s]
+  # FCC-ee Z pole example: 5.96E-06, 23.8E-09, 0.397E-03, 36.3E-12
+  set SigmaX 0.0
+  set SigmaY 0.0
+  set SigmaZ 0.0
+  set SigmaT 0.0
+}
+
+
+#################################
+# Truth Vertex Finder
+#################################
+
+module TruthVertexFinder TruthVertexFinder {
+
+  ## below this distance two vertices are assumed to be merged
+  set Resolution 1E-06
+
+  set InputArray Delphes/stableParticles
+  set VertexOutputArray vertices
+}
+
+
+#################################
+# Propagate particles in cylinder
+#################################
+
+module ParticlePropagator ParticlePropagator {
+  set InputArray Delphes/stableParticles
+
+  set OutputArray stableParticles
+  set ChargedHadronOutputArray chargedHadrons
+  set ElectronOutputArray electrons
+  set MuonOutputArray muons
+
+  # inner radius of the solenoid, in m
+  set Radius $::R
+
+  # half-length: z of the solenoid, in m
+  set HalfLength $::HL
+
+  # magnetic field, in T
+  set Bz $::B
+}
+
+####################################
+# Charged hadron tracking efficiency
+####################################
+
+module Efficiency ChargedHadronTrackingEfficiency {
+    set InputArray ParticlePropagator/chargedHadrons
+    set OutputArray chargedHadrons
+    set UseMomentumVector true
+
+    set EfficiencyFormula {
+        (abs(eta) > 2.6)                                  * (0.000) +
+        (pt < 0.1) * (abs(eta) <= 2.6)       * (0.000) +
+        (pt >= 0.1) * (abs(eta) <= 2.6)      * (1.000)
+    }
+}
+
+
+
+##############################
+# Electron tracking efficiency
+##############################
+
+module Efficiency ElectronTrackingEfficiency {
+    set InputArray ParticlePropagator/electrons
+    set OutputArray electrons
+    set UseMomentumVector true
+
+    set EfficiencyFormula {
+        (abs(eta) > 2.6)                                  * (0.000) +
+        (pt < 0.1) * (abs(eta) <= 2.6)                    * (0.000) +
+        (pt >= 0.1) * (abs(eta) <= 2.6)                   * (1.000)
+    }
+}
+
+
+##########################
+# Muon tracking efficiency
+##########################
+
+module Efficiency MuonTrackingEfficiency {
+    set InputArray ParticlePropagator/muons
+    set OutputArray muons
+    set UseMomentumVector true
+
+    set EfficiencyFormula {
+        (abs(eta) > 2.6)                                  * (0.000) +
+        (pt < 0.1) * (abs(eta) <= 2.6)       * (0.000) +
+        (pt >= 0.1) * (abs(eta) <= 2.6)      * (1.000)
+    }
+}
+
+##############
+# Track merger
+##############
+
+module Merger TrackMergerPre {
+# add InputArray InputArray
+  add InputArray ChargedHadronTrackingEfficiency/chargedHadrons
+  add InputArray ElectronTrackingEfficiency/electrons
+  add InputArray MuonTrackingEfficiency/muons
+  set OutputArray tracks
+}
+
+
+
+########################################
+# Smearing for charged tracks
+########################################
+
+module TrackCovariance TrackSmearing {
+
+    set InputArray TrackMergerPre/tracks
+    set OutputArray tracks
+
+    ## minimum number of hits to accept a track
+    set NMinHits 6
+
+    ## magnetic field
+    set Bz $::B
+
+    ## scale factors
+    set ElectronScaleFactor  {1.25}
+
+
+    set DetectorGeometry {
+
+      # Layer type 1 = R (barrel) or 2 = z (forward/backward)
+      # Layer label
+      # Minimum dimension z for barrel or R for forward
+      # Maximum dimension z for barrel or R for forward
+      # R/z location of layer
+      # Thickness (meters)
+      # Radiation length (meters)
+      # Number of measurements in layers (1D or 2D)
+      # Stereo angle (rad) - 0(pi/2) = axial(z) layer - Upper side
+      # Stereo angle (rad) - 0(pi/2) = axial(z) layer - Lower side
+      # Resolution Upper side (meters) - 0 = no measurement
+      # Resolution Lower side (meters) - 0 = no measurement
+      # measurement flag = T, scattering only = F
+
+      # barrel  name       zmin   zmax   r        w (m)      X0        n_meas  th_up (rad) th_down (rad)    reso_up (m)   reso_down (m)  flag
+
+      # beam pipe (AlBeMet + paraffin + Au, 0.68% X0 at 90 deg as in k4geo)
+      1 PIPE -100 100 0.01 0.00241 0.35276 0 0 0 0 0 0
+      # vertex detector: 5 curved MAPS layers, 10 um pixels, 140 mrad acceptance, ~0.05% X0 per layer
+      1 VTX -0.092 0.092 0.013 5e-05 0.0937 2 0 1.5708 3e-06 3e-06 1
+      1 VTX -0.128 0.128 0.018 5e-05 0.0937 2 0 1.5708 3e-06 3e-06 1
+      1 VTX -0.163 0.163 0.023 5e-05 0.0937 2 0 1.5708 3e-06 3e-06 1
+      1 VTX -0.199 0.199 0.028 5e-05 0.0937 2 0 1.5708 3e-06 3e-06 1
+      1 VTX -0.234 0.234 0.033 5e-05 0.0937 2 0 1.5708 3e-06 3e-06 1
+      # outer tracker barrel: 4 stations, each two MAPS planes on the faces of a 5 cm foam stave (k4geo OuterTrackerBarrel_o1_v00)
+      1 OTB -1.345 1.345 0.767 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      1 OTB -1.345 1.345 0.82 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      1 OTB -1.345 1.345 0.893 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      1 OTB -1.345 1.345 0.946 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      1 OTB -1.345 1.345 1.587 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      1 OTB -1.345 1.345 1.64 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      1 OTB -1.345 1.345 1.714 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      1 OTB -1.345 1.345 1.767 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      # ARC barrel as passive material: 20 cm, 5.8% X0 at 90 deg (k4geo T04 material scan)
+      1 ARCB -2.2 2.2 2 0.2 3.45 0 0 0 0 0 0
+      # outer tracker endcaps: 4 double disks per side (ALFA Delphes card, Jul 2026; engineering design in progress)
+      2 OTE 0.15 1.78 -2.045 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 -1.995 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 -1.835 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 -1.785 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 -1.625 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 -1.575 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 -1.415 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 -1.365 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 1.365 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 1.415 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 1.575 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 1.625 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 1.785 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 1.835 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 1.995 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      2 OTE 0.15 1.78 2.045 0.000187 0.0937 2 0 1.5708 3e-06 3e-06 1
+      # ARC endcaps as passive material
+      2 ARCE 0.28 1.9 -2.1 0.2 3.45 0 0 0 0 0 0
+      2 ARCE 0.28 1.9 2.1 0.2 3.45 0 0 0 0 0 0
+
+    }
+
+}
+
+#########################################
+# ARC: Array of RICH Cells, per-track PID
+#########################################
+
+module ARCPID ARCPID {
+  set InputArray TrackSmearing/tracks
+  set OutputArray tracks
+
+  set Bz $::B
+
+  ## ARC envelope [m]
+  set BarrelRmin $::ARCBRMIN
+  set BarrelRmax $::ARCBRMAX
+  set BarrelZmax $::ARCBZMAX
+  set EndcapZmin $::ARCEZMIN
+  set EndcapZmax $::ARCEZMAX
+  set EndcapRmin $::ARCERMIN
+  set EndcapRmax $::ARCERMAX
+
+  ## gas radiator: C4F10 at 1 bar (k4geo C4F10_PFRICH table), for comparison with the July 2026 study. n and dn/dE at the
+  ## PDE-weighted mean detected photon energy <E> = 3.05 eV, sigma_E = rms of the detected spectrum (T11prep, standalone ARC cell).
+  ## calibrated on its own cell-averaged full sim (work/T06c: C4F10 in the ALFA ARC, PDE sampled).
+  set GasRefractiveIndex 1.001333
+  set GasDnDe 2.25E-5
+  set GasSigmaE 0.667
+  ## per-photon resolution without the chromatic part [rad] (pixel 1.25 (+) emission), cell-averaged full sim (T06b), smooth in the
+  ## cell off-axis variable; even-polynomial fits (s1^2 and s_c^2 in mrad^2, chromatic included in s1 and removed here; Y; E).
+  ## Residuals of the smooth forms around the cell-averaged points: s1 <= 2%, s_c 3-9%, Y and E <= 3.6% rms (systematic):
+  ##   s1_barrel: even polynomial in x, c = 9.424, 8.533, -7.629 (chi2/ndf 2.35, x in [0.065, 0.962])
+  ##   s1_endcap: even polynomial in x, c = 8.455, 5.083 (chi2/ndf 0.74, x in [0.237, 0.777])
+  ##   sc_barrel: even polynomial in x, c = 0.4511, 3.213, -2.222 (chi2/ndf 0.80, x in [0.065, 0.962])
+  ##   sc_endcap: even polynomial in x, c = 0.1213, 1.173 (chi2/ndf 1.48, x in [0.237, 0.777])
+  ##   Y_barrel: even polynomial in x, c = 0.9894, -1.557, 3.142, -1.908 (chi2/ndf 2.56, x in [0.065, 0.962])
+  ##   Y_endcap: even polynomial in x, c = 1.063, -1.305, 3.123, -2.828 (chi2/ndf 1.14, x in [0.237, 0.777])
+  ##   E_barrel: even polynomial in x, c = 0.9965, -0.4042, 0.265 (chi2/ndf 4.43, x in [0.065, 0.962])
+  ##   E_endcap: even polynomial in x, c = 1.029, -0.445 (chi2/ndf 9.10, x in [0.237, 0.777])
+  set GasSigmaSingle 0.003056
+  set GasSigmaSingleFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (9.42389) + (8.53275) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (-7.62855) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4) - (0.0841)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.004986) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (8.45518) + (5.08255) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2) - (0.0841))))
+  }
+  ## per-track correlated term [rad] (does not average down with N_pe): cell-position-dependent bias of the optics
+  set GasSigmaCorrFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (0.451072) + (3.21338) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (-2.2221) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4) - (0)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.002097) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (0.121307) + (1.17337) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2) - (0))))
+  }
+  ## photons at beta = 1 for L = L_ref at normal incidence (cell-averaged); ideal mirror, x 0.90 for a 90% mirror (T07)
+  set GasNsat 10.24
+  set GasLref 0.15
+  ## gas crossed at normal incidence through the k4geo cells (T12 part A): 16.9 cm barrel, 16.7 cm endcap
+  set GasThickness 0.169
+  ## light collection relative to the path scaling N_sat L / L_ref (photons leave the cell at oblique incidence)
+  set GasYieldScaleFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, (0.989363) + (-1.55742) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (3.14241) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4) + (-1.90762) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 6))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.4915) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, (1.06341) + (-1.30469) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2) + (3.12263) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 4) + (-2.82755) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 6)))
+  }
+
+  ## aerogel radiator: k4geo Aerogel_PFRICH (design value 1.03 not used by the full sim). n and dn/dE at the detected <E> = 3.0 eV,
+  ## sigma_E = rms of the detected aerogel spectrum (T12, 90 deg). The chromatic term (2.7 mrad at beta = 1) dominates.
+  set AerogelRefractiveIndex 1.0193
+  # set AerogelRefractiveIndex 1.03   ;# design value
+  set AerogelDnDe 7.9E-4
+  set AerogelSigmaE 0.655
+  ## per-photon resolution without the chromatic part [rad] (pixel 1.23 (+) emission); fits (mrad, chromatic included):
+  ##   s1_barrel: even polynomial in x, c = 8.318, 3.718 (chi2/ndf 3.33, x in [0.065, 0.962])
+  ##   s1_endcap: even polynomial in x, c = 7.644, 9.55, -10.12 (chi2/ndf 2.48, x in [0.237, 0.777])
+  ##   sc_barrel: even polynomial in x, c = 1.464, 9.21, 10.66 (chi2/ndf 4.55, x in [0.065, 0.962])
+  ##   sc_endcap: even polynomial in x, c = 0.2955, 13.26 (chi2/ndf 1.28, x in [0.237, 0.777])
+  ##   Y_barrel: even polynomial in x, c = 0.9731, 0.4414, -0.4633 (chi2/ndf 3.23, x in [0.065, 0.962])
+  ##   Y_endcap: even polynomial in x, c = 0.9451, 0.689, -1.218 (chi2/ndf 3.42, x in [0.237, 0.777])
+  ##   E_barrel: even polynomial in x, c = 0.9474, -0.3253, 0.3676 (chi2/ndf 5.26, x in [0.065, 0.962])
+  ##   E_endcap: even polynomial in x, c = 0.9632, -0.152 (chi2/ndf 1.70, x in [0.237, 0.777])
+  set AerogelSigmaSingle 0.001066
+  set AerogelSigmaSingleFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (8.31823) + (3.71817) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) - (7.1824)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.001493) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (7.64374) + (9.55035) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2) + (-10.1174) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 4) - (7.1824))))
+  }
+  set AerogelSigmaCorrFormula {
+    (abs(eta) <= 0.9013) * (0.001 * sqrt(TMath::Max(0.0, (1.46379) + (9.20963) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (10.6606) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4) - (0)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.003881) +
+    (abs(eta) > 1.0298) * (0.001 * sqrt(TMath::Max(0.0, (0.295488) + (13.258) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2) - (0))))
+  }
+  set AerogelNsat 7.14
+  set AerogelLref 0.01
+  set AerogelThickness 0.0098
+  set AerogelYieldScaleFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, (0.973073) + (0.441369) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (-0.463303) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.6752) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, (0.945113) + (0.688964) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2) + (-1.21823) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 4)))
+  }
+
+  ## per-photon spread from the track curving across the radiator: sigma_bend = BendingCoefficient * 0.3 * B * L * sin(theta) / p,
+  ## weighted mean of the per-bin gas fits (T06b); the T06 reconstruction already corrects for the helix, so k < 1/sqrt(12)
+  set BendingCoefficient 0.152
+
+  ## a ring needs at least MinPe detected photons (as in the T06 reconstruction); the yield fluctuates per track (Poisson)
+  set MinPe 3.0
+  set SigmaTrack 0.0
+  set PoissonFluctuation true
+  set UseTrueMomentumForPID false
+
+  ## ring-finding efficiency (ring lost: cell edge, mirror gap; < 3 photons is handled by MinPe), cell-averaged
+  set GasEfficiencyFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, TMath::Min(1.0, (0.996478) + (-0.404233) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (0.26502) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.08889) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, TMath::Min(1.0, (1.02932) + (-0.445019) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2))))
+  }
+  set AerogelEfficiencyFormula {
+    (abs(eta) <= 0.9013) * (TMath::Max(0.0, TMath::Min(1.0, (0.947423) + (-0.325302) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 2) + (0.367565) * pow(TMath::Min(TMath::Max(sinh(abs(eta)), 0.0652), 0.9618), 4)))) +
+    (abs(eta) > 0.9013 && abs(eta) <= 1.0298) * (0.149) +
+    (abs(eta) > 1.0298) * (TMath::Max(0.0, TMath::Min(1.0, (0.963182) + (-0.151971) * pow(TMath::Min(TMath::Max((1.0/sinh(abs(eta) + 1e-9)), 0.2371), 0.7769), 2))))
+  }
+}
