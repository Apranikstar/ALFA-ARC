diff --git a/FCCee/ALFA/compact/ALFA_o1_v01/ALFA_o1_v01.xml b/FCCee/ALFA/compact/ALFA_o1_v01/ALFA_o1_v01.xml
new file mode 100644
index 00000000..d162ae06
--- /dev/null
+++ b/FCCee/ALFA/compact/ALFA_o1_v01/ALFA_o1_v01.xml
@@ -0,0 +1,89 @@
+<lccdd>
+
+  <info name="ALFA_o1_v01"
+    title="Master file for the ALFA detector concept"
+    author="Various, Tracker by E.Ploerer, Grainita ECAL by F.Guo, ARC from CLD_o3_v01 (A. Tolosa-Delgado et al.)"
+    url="no"
+    status="development"
+    version="o1_v01">
+    <comment>
+      Based on IDEA master file.
+      Tracker corresponds to BAR354_EC353_VTX108 Delphes card.
+      o1_v01: ALFA_o1_v00 + ARC barrel and endcaps (ARC_geo_o1_v01 driver) with a pressurised xenon gas radiator.
+    </comment>
+  </info>
+
+  <include ref="${DD4hepINSTALL}/DDDetectors/compact/detector_types.xml" />
+
+  <comment> Material definitions </comment>
+  <includes>
+    <gdmlFile  ref="elements.xml"/>
+    <gdmlFile  ref="materials.xml"/>
+  </includes>
+
+  <comment> World dimensions </comment>
+  <define>
+    <constant name="world_side"   value="20.0*m"/>
+    <constant name="world_x"      value="world_side / 2.0"/>
+    <constant name="world_y"      value="world_side / 2.0"/>
+    <constant name="world_z"      value="world_side / 2.0"/>
+  </define>
+
+  <comment> Global detector dimensions </comment>
+  <include ref="DectDimensions_ALFA_o1_v01.xml" />
+  <include ref="display.xml" />
+
+
+  <comment> Tracker bitfield </comment>
+  <define>
+    <constant name="GlobalTrackerReadoutID" type="string" value="system:8,side:-2,layer:5,module:13,sensor:7"/>
+    <comment> Silicon barrel tracker has 5 (VTX) + 6*4 (OT) layers => min 5 bits. Silicon OT final layer has 112 * 2 * 21 modules / n ("layers" / physical double layer) => min 13 bits. Assume vertex barrel 60 pixel matrices per module (IDEA) => min 6 bits. </comment>
+  </define>
+
+
+  <comment> Shape-based beam pipe </comment>
+  <include ref="MDI_params.xml" />
+  <include ref="../../../MDI/compact/MDI_o1_v00/Beampipe_o4_v05.xml" />
+  <include ref="../../../MDI/compact/MDI_o1_v00/BeamInstrumentation_o1_v01.xml" />
+
+  <comment> Sub-detector definitions </comment>
+
+  <comment> Outer Tracker (OT) Barrel  </comment>
+  <include ref="OuterTrackerBarrel_o1_v00.xml" />
+
+  <comment> ARC: Array of RICH Cells (aerogel + pressurised xenon), between OT and ECAL </comment>
+  <include ref="ARC_o1_v01.xml" />
+
+  <comment> Grainita ECAL </comment>
+  <include ref="Grainita_ECAL_Barrel_o1_v02.xml" /> 
+
+  <comment> Include plugin to generate edm4hep::TrackerHitPlane </comment>
+  <plugins>
+    <plugin name="DD4hepVolumeManager"/>
+    <plugin name="InstallSurfaceManager"/>
+  </plugins>
+
+  <comment> Magnetic field constants </comment>
+  <define>
+    <constant name="Solenoid_inner_field"   value="3.0*tesla"/>
+    <constant name="Solenoid_outer_field"   value="-1.0*tesla"/>
+  </define>
+
+  <comment> Magnetic field definition </comment>
+  <comment> Assume constant field for lt inner field and lt outer field (beyond coil) </comment>
+  <fields>
+    <field name="Solenoid" type="solenoid"
+      inner_field="Solenoid_inner_field"
+      outer_field="Solenoid_outer_field"
+      zmax="1.2 * Solenoid_coil_half_length"
+      outer_radius="Solenoid_coil_outer_radius">
+    </field>
+  </fields>
+
+
+
+
+
+
+
+</lccdd>
diff --git a/FCCee/ALFA/compact/ALFA_o1_v01/ARC_o1_v01.xml b/FCCee/ALFA/compact/ALFA_o1_v01/ARC_o1_v01.xml
new file mode 100644
index 00000000..3705983d
--- /dev/null
+++ b/FCCee/ALFA/compact/ALFA_o1_v01/ARC_o1_v01.xml
@@ -0,0 +1,131 @@
+<lccdd >
+
+<includes>
+  <gdmlFile ref="materials_arc_o1_v01.xml"/>
+  <gdmlFile ref="../../../CLD/compact/CLD_o3_v01/RadiatorCell_FinalOptimisation_o1_v01.xml"/>
+</includes>
+
+<define>
+  <!-- ARC properties -->
+  <constant name="ARC_VESSEL_WALL_THICKNESS"  value="1.0*cm"    />
+  <constant name="ARC_MIRROR_THICKNESS"       value="0.2*cm"    />
+  <constant name="ARC_COOLING_THICKNESS"      value="0.2*cm"    />
+  <constant name="ARC_AEROGEL_THICKNESS"      value="1.0*cm"    />
+  <!-- ARC sensor properties -->
+  <constant name="ARC_SENSOR_THICKNESS"       value="0.2*cm"    />
+  <constant name="ARC_SENSOR_X"               value="8.0*cm"    />
+  <constant name="ARC_SENSOR_Y"               value="8.0*cm"    />
+  <constant name="ARC_SENSOR_NStripsX"        value="100"       />
+  <constant name="ARC_SENSOR_NStripsY"        value="100"       />
+  <constant name="ARC_SENSOR_pitchX"          value="0.08*cm"   />
+  <constant name="ARC_SENSOR_pitchY"          value="0.08*cm"   />
+</define>
+
+<detectors>
+  <detector
+    id="DetID_ARCBARREL"
+    name="ARCBARREL"
+    type="ARCBARREL_o1_v01_T"
+    readout="ArcCollection"
+    >
+  <!-- /detectors/detector/vessel -->
+  <vessel
+      skinMaterial="CarbonFibStr"
+      skin_vis="arc_vessel_vis"
+      bulk_material="Rohacell300WP"
+      bulk_vis="arc_vessel_bulk_vis"
+      bulk_skin_ratio = "0.8"
+    >
+  </vessel>
+  <!-- /detectors/detector/radiatorgas -->
+  <!-- ALFA: pressurised xenon radiator (Xenon_ARC, materials_arc_o1_v01.xml) -->
+  <radiatorgas
+      material="Xenon_ARC"
+      vis="arc_gas_vis"
+    >
+  </radiatorgas>
+  <!-- /detectors/detector/radiatoraerogel -->
+  <radiatoraerogel
+      material="Aerogel_PFRICH"
+      vis="arc_aerogel_vis"
+    >
+  </radiatoraerogel>
+  <!-- /detectors/detector/sensors -->
+  <sensors
+      material="SiliconOptical"
+      vis="arc_sensor_vis"
+      sensor_side_Z="ARC_SENSOR_Y"
+      sensor_side_Phi="ARC_SENSOR_X"
+      thickness="ARC_SENSOR_THICKNESS"
+      >
+  </sensors>
+  <!-- /detectors/detector/mirror -->
+  <mirror
+      material="CarbonFibStr"
+      thickness="ARC_MIRROR_THICKNESS"
+      surface="ARC_MirrorSurface"
+      >
+  </mirror>
+  </detector>
+  <detector
+    id="DetID_ARCENDCAP"
+    name="ARCENDCAP"
+    type="ARCENDCAP_o1_v01_T"
+    readout="ArcCollection"
+    zpos = "ArcEndcap_position_z"
+    >
+  <!-- /detectors/detector/vessel -->
+  <vessel
+      skinMaterial="CarbonFibStr"
+      skin_vis="arc_vessel_vis"
+      bulk_material="Rohacell300WP"
+      bulk_vis="arc_vessel_bulk_vis"
+      bulk_skin_ratio = "0.8"
+    >
+  </vessel>
+  <!-- /detectors/detector/radiatorgas -->
+  <!-- ALFA: pressurised xenon radiator (Xenon_ARC, materials_arc_o1_v01.xml) -->
+  <radiatorgas
+      material="Xenon_ARC"
+      vis="arc_gas_vis"
+    >
+  </radiatorgas>
+  <!-- /detectors/detector/radiatoraerogel -->
+  <radiatoraerogel
+      material="Aerogel_PFRICH"
+      vis="arc_aerogel_vis"
+    >
+  </radiatoraerogel>
+  <!-- /detectors/detector/sensors -->
+  <sensors
+      material="SiliconOptical"
+      vis="arc_sensor_vis"
+      sensor_side_Y="ARC_SENSOR_Y"
+      sensor_side_X="ARC_SENSOR_X"
+      thickness="ARC_SENSOR_THICKNESS"
+      >
+  </sensors>
+  <!-- /detectors/detector/mirror -->
+  <mirror
+      material="CarbonFibStr"
+      thickness="ARC_MIRROR_THICKNESS"
+      surface="ARC_MirrorSurface"
+      >
+  </mirror>
+  </detector>
+</detectors>
+
+<readouts>
+  <readout name="ArcCollection">
+    <segmentation
+      type="CartesianGridXY"
+      grid_size_x="ARC_SENSOR_pitchX"
+      grid_size_y="ARC_SENSOR_pitchY"
+      offset_x="-0.5*(ARC_SENSOR_NStripsX-1)*ARC_SENSOR_pitchX"
+      offset_y="-0.5*(ARC_SENSOR_NStripsY-1)*ARC_SENSOR_pitchY"
+      />
+      <id>system:5,barrel:3,cellnumber:24,x:32:-16,y:-16</id>
+  </readout>
+</readouts>
+
+</lccdd>
diff --git a/FCCee/ALFA/compact/ALFA_o1_v01/DectDimensions_ALFA_o1_v01.xml b/FCCee/ALFA/compact/ALFA_o1_v01/DectDimensions_ALFA_o1_v01.xml
new file mode 100644
index 00000000..004e51f9
--- /dev/null
+++ b/FCCee/ALFA/compact/ALFA_o1_v01/DectDimensions_ALFA_o1_v01.xml
@@ -0,0 +1,59 @@
+<lccdd>
+
+  <comment> Global dimensions and detector identifiers for ALFA_o1_v01 </comment>
+  <define>
+
+    <constant name="DetID_OTBar_Barrel" value="3"/>
+    <constant name="DetID_ECAL_Barrel"  value="10"/>
+    <constant name="DetID_ECAL_Endcap"  value="11"/>
+    <constant name="DetID_HCAL_Barrel"  value="12"/>
+    <constant name="DetID_HCAL_Endcap"  value="13"/>
+    <constant name="DetID_ARCBARREL"    value="20"/>
+    <constant name="DetID_ARCENDCAP"    value="21"/>
+
+    <constant name="env_safety" value="0.1*mm"/>
+
+    <constant name="tracker_region_zmax"   value="2.1*m"/>
+    <constant name="tracker_region_rmax"      value="1.8*m"/>
+
+    <constant name="OTBar_inner_radius"   value="500*mm"/>
+    <constant name="OTBar_outer_radius"   value="1800*mm"/>
+    <constant name="OTBar_nGroupingModules" value="1"/>
+
+    <constant name="ECalBarrel_inner_radius" value="2200*mm"/>
+    <constant name="ECalBarrel_outer_radius" value="2650*mm"/>
+    <constant name="ECalBarrel_half_length" value="2300*mm"/>
+
+    <comment>
+      ARC between the outer tracker (r &lt; 1800 mm, |z| &lt; 1345 mm) and the ECAL barrel (r &gt; 2200 mm).
+      Radii and lengths are the CLD_o3_v01 values: the cell optics (RadiatorCell_FinalOptimisation_o1_v01.xml)
+      are optimised for them, so changing them needs a re-optimisation, not a rescale.
+      They match the ALFA design (FCC reco workshop, 26 Oct 2026): 20 cm depth, ~27 cm hexagonal cells.
+      The endcap spans ArcEndcap_position_z +- ArcEndcap_total_length/2 = 2000-2200 mm, clear of the OT barrel
+      (|z| &lt; 1345 mm) and of the compensating solenoid (r &lt; 200 mm).
+    </comment>
+    <constant name="ArcBarrel_inner_radius"  value="1900*mm"/>
+    <constant name="ArcBarrel_outer_radius"  value="2100*mm"/>
+    <constant name="ArcBarrel_total_length"  value="4400*mm"/>
+    <constant name="ArcEndcap_inner_radius"  value="280*mm"/>
+    <constant name="ArcEndcap_outer_radius"  value="1900*mm"/>
+    <constant name="ArcEndcap_total_length"  value="200*mm"/>
+    <constant name="ArcEndcap_position_z"    value="2100*mm"/>
+
+    <comment> ARC xenon radiator working point. Baseline 2 bar: Xe matches the C4F10 index (same ring radius) at 1.98 bar,
+      so the C4F10-optimised cells apply; 1-3 bar scan foreseen (M. Defranchis, ARC pre-demonstrator, ALFA meeting 16 Oct 2026).
+      The ring moves by ~0.1 mrad/K at fixed pressure, so keep the temperature consistent. Ideal-gas scaling from 273.15 K, 1 atm. </comment>
+    <constant name="ARC_XE_PRESSURE_BAR"     value="2.0"/>
+    <constant name="ARC_XE_TEMPERATURE_K"    value="293.15"/>
+    <constant name="ARC_XE_DENSITY_FACTOR"   value="(ARC_XE_PRESSURE_BAR/1.01325)*(273.15/ARC_XE_TEMPERATURE_K)"/>
+
+    <comment> ARC mirror reflectivity (flat). 1.0 = ideal, the k4geo CLD default and the value used for T02-T06;
+      0.90 is the realistic placeholder studied in T07. </comment>
+    <constant name="ARC_MIRROR_REFLECTIVITY" value="1.0"/>
+
+    <constant name="Solenoid_coil_half_length"      value="2.0*m"/>
+    <constant name="Solenoid_coil_outer_radius"      value="2.7*m"/>
+
+  </define>
+
+</lccdd>
diff --git a/FCCee/ALFA/compact/ALFA_o1_v01/Grainita_ECAL_Barrel_o1_v02.xml b/FCCee/ALFA/compact/ALFA_o1_v01/Grainita_ECAL_Barrel_o1_v02.xml
new file mode 100644
index 00000000..4c347e63
--- /dev/null
+++ b/FCCee/ALFA/compact/ALFA_o1_v01/Grainita_ECAL_Barrel_o1_v02.xml
@@ -0,0 +1,80 @@
+
+<lccdd>
+<!-- #==========================================================================
+     #  AIDA Detector description implementation 
+     #==========================================================================
+     # Copyright (C) Organisation europeenne pour la Recherche nucleaire (CERN)
+     # All rights reserved.
+     #
+     # For the licensing terms see $DD4hepINSTALL/LICENSE.
+     # For the list of contributors see $DD4hepINSTALL/doc/CREDITS.
+     #
+     #==========================================================================
+-->
+  <!-- <info name="Grainita_ECAL_Barrel_v02"
+    title="Grainita ECAL full detector geometry (first ver.)"
+    author="Fangyi Guo"
+    url="None"
+    status="development"
+    version="0.1">
+  </info> -->
+
+  <define>
+
+    <!-- Global structure -->
+    <constant name="InnerRadius"          value="ECalBarrel_inner_radius"/>
+    <constant name="OuterRadius"          value="ECalBarrel_outer_radius"/>
+    <constant name="CrystalThickness"     value="40.5*cm"/>
+    <constant name="BackSpace"            value="1.8*cm"/>
+    <constant name="HalfZ"                value="ECalBarrel_half_length"/>
+    <constant name="NumberOfPhiSectors"   value="72"/>
+    <constant name="NumberOfZModules"     value="15"/>
+
+    <!-- Module -->
+    <constant name="FrameThickness"       value="10*mm"/>
+    <constant name="SegThickness"         value="2.5*mm"/>
+    <constant name="ModuleTiltAngle"      value="1.5*deg"/>
+
+    <!-- Cell -->
+    <!-- Segmentation to achieve readout granularity of 7 mm in front of ECAL barrel surface.
+    It corresponds to AngularGranularity = 3.2 mrad
+    Two longitudinal segmentations are achieved from short-long fiber structure.  -->
+    <constant name="AngularGranularity"   value="3.2*mrad"/>   
+    <constant name="rho0"                 value="FrameThickness"/>   
+    <constant name="rho1"                 value="FrameThickness + CrystalThickness/5"/>   
+    <constant name="rho2"                 value="FrameThickness + CrystalThickness+10*mm"/>   
+
+
+  </define>
+  
+
+  <!-- Define the detector. A detector has a name, type to be returned in .cpp file with 
+       DECLARE_DETELEMENT(type,create_detector_c++method), vis attributes (optional),
+       and sensitive-detector (true/false), if sensitive="true" a readout must the passed.
+       If a detector contains sub-detectors, their information must be included as below.
+  -->
+  <detectors>
+    <detector name="Grainita_ECAL_Barrel_v02" type="Grainita_ECAL_Barrel_v02" vis="CaloVis" id ="10" readout="GrainitaEcalBarrelRO" material="MixGrains">
+    <type_flags type=" DetType_CALORIMETER + DetType_ELECTROMAGNETIC + DetType_BARREL"/>
+    </detector>
+  </detectors>
+
+
+  <readouts>
+    <readout name="GrainitaEcalBarrelRO">
+      <segmentation type="FCCSWGridRhoPhiTheta_k4geo"
+              phi_bins="2*pi/AngularGranularity"
+              grid_size_theta="AngularGranularity"
+              rho_bins="rho0 rho1 rho2"
+              rho_bin_count="2"
+              min_theta="atan((InnerRadius+FrameThickness)/HalfZ)-ModuleTiltAngle"
+              max_theta="pi-atan((InnerRadius+FrameThickness)/HalfZ)+ModuleTiltAngle"
+              clear_extra_fields="1"
+              offset_R="InnerRadius"/>
+      <id>system:5,stave:6,sector:7,phi:-16,theta:16,rho:5</id>
+    </readout>
+  </readouts> 
+
+
+
+</lccdd>
