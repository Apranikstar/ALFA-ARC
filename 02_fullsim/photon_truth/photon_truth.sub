# T15 photon-truth sample: pi+ 30/40/50 GeV, central barrel cell, 10 x 20 events each (keepAllParticles, ~25 s/event)
executable            = /afs/cern.ch/work/h/hfatehi/alfa/ALFA-ARC/02_fullsim/photon_truth/run_photon_truth.sh
arguments             = $(p) $(nev) $(seed) $(chunk)
output                = /afs/cern.ch/work/h/hfatehi/alfa/ALFA-ARC/02_fullsim/photon_truth/logs/$(ClusterId).$(ProcId).out
error                 = /afs/cern.ch/work/h/hfatehi/alfa/ALFA-ARC/02_fullsim/photon_truth/logs/$(ClusterId).$(ProcId).err
log                   = /afs/cern.ch/work/h/hfatehi/alfa/ALFA-ARC/02_fullsim/photon_truth/logs/t15.log
request_cpus          = 1
request_memory        = 4000MB
request_disk          = 6GB
+JobFlavour           = "longlunch"
should_transfer_files = YES
max_retries           = 2
queue p, nev, seed, chunk from /afs/cern.ch/work/h/hfatehi/alfa/ALFA-ARC/02_fullsim/photon_truth/grid.txt
