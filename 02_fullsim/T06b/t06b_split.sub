# T06b cell-averaged grid: ALFA_o1_v01 (ARC xenon 2 bar); species x momentum, theta uniform 12-90 deg, 4 x 1000 events.
# split resubmission: p = 20, 30, 50 GeV as 40 x 100 events per species and momentum (360 jobs)
executable            = /afs/cern.ch/work/h/hfatehi/alfa/condor/T06b/t06b_job.sh
arguments             = $(particle) $(p) $(nev) $(seed) $(chunk)
output                = /afs/cern.ch/work/h/hfatehi/alfa/condor/T06b/logs/$(ClusterId).$(ProcId).out
error                 = /afs/cern.ch/work/h/hfatehi/alfa/condor/T06b/logs/$(ClusterId).$(ProcId).err
log                   = /afs/cern.ch/work/h/hfatehi/alfa/condor/T06b/logs/t06b_split.log
request_cpus          = 1
request_memory        = 3500MB
+JobFlavour           = "longlunch"
should_transfer_files = YES
max_retries           = 2
queue particle, p, nev, seed, chunk from /afs/cern.ch/work/h/hfatehi/alfa/condor/T06b/grid_split.txt
