# T06c: as T06b with C4F10 in the ALFA ARC; p < 20 GeV 4 x 1000 events, p >= 20 GeV 40 x 100 events (444 jobs).

executable            = /afs/cern.ch/work/h/hfatehi/alfa/condor/T06c/t06c_job.sh
arguments             = $(particle) $(p) $(nev) $(seed) $(chunk)
output                = /afs/cern.ch/work/h/hfatehi/alfa/condor/T06c/logs/$(ClusterId).$(ProcId).out
error                 = /afs/cern.ch/work/h/hfatehi/alfa/condor/T06c/logs/$(ClusterId).$(ProcId).err
log                   = /afs/cern.ch/work/h/hfatehi/alfa/condor/T06c/logs/t06c.log
request_cpus          = 1
priority              = 5
request_memory        = 3500MB
+JobFlavour           = "longlunch"
should_transfer_files = YES
max_retries           = 2
queue particle, p, nev, seed, chunk from /afs/cern.ch/work/h/hfatehi/alfa/condor/T06c/grid.txt
